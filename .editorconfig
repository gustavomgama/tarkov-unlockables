# Keeps editors agreeing with the formatters the project already uses
# (rubocop for Ruby, erb_lint for templates, Tailwind for CSS).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rb,rake,erb,yml,yaml,js,json,css}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
# Markdown hard-wraps at two trailing spaces; leave them alone.
trim_trailing_whitespace = false
