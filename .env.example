# Copy to .env (never commit .env). Kamal reads secrets from here.
# NOTE: use the same password in POSTGRES_PASSWORD and DATABASE_URL.
KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:PASTE_SAME_PASSWORD@tarkov-db-postgres:5432/tarkov_db_prod
