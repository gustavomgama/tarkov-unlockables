<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Tasks (<%= @total_count %>)</h1>
  <%= link_to "New Task", [:new, :admin, :task], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= form_tag admin_tasks_path, method: :get, class: "mb-4 flex items-center gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search tasks...", class: "flex-1 px-3 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] focus:outline-none" %>
  <button type="submit" class="px-4 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)]">
    Search
  </button>
<% end %>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "BSG ID", field: :bsg_id },
  { label: "Name", field: :name, truncate: 30, link: true },
  { label: "Given By", field: :given_by },
  { label: "Kappa", field: :kappa_required }
], @resources) %>

<%= render "admin/shared/pagination" %>
