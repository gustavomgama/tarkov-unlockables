<%= render "admin/shared/index_header", title: "Tasks", new_label: "Task",
                                        new_path: [:new, :admin, :task], search_path: admin_tasks_path,
                                        placeholder: "Search tasks..." %>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "BSG ID", field: :bsg_id },
  { label: "Name", field: :name, truncate: 30, link: true },
  { label: "Given By", field: :given_by },
  { label: "Kappa", field: :kappa_required }
], @resources) %>

<%= render "admin/shared/pagination" %>
