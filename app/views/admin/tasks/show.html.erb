<div class="mb-4">
  <%= link_to "← Back", [:admin, :tasks], class: "text-[var(--accent)] hover:underline" %>
</div>

<div class="bg-[var(--bg-panel)] p-6 border border-[var(--border)]">
  <h1 class="text-2xl font-bold text-[var(--text-bright)] mb-6"><%= @resource.full_name %></h1>
  <div class="mb-6 flex gap-4">
    <%= link_to "Edit", [:edit, :admin, @resource], class: "px-4 py-2 bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:bg-[var(--bg-elevated)] transition-colors" %>
    <%= button_to "Delete", [:admin, @resource], method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-[var(--danger)] text-white hover:opacity-90" %>
  </div>

  <dl class="grid grid-cols-2 gap-6">
    <div>
      <dt class="text-[var(--text-muted)] text-sm">ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">BSG ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.bsg_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Name</dt>
      <dd class="text-[var(--text)]"><%= @resource.name %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Given By</dt>
      <dd class="text-[var(--text)]"><%= @resource.given_by %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Wiki Link</dt>
      <dd class="text-[var(--text)]">
        <% if @resource.wiki_link.present? %>
          <%= link_to @resource.wiki_link, @resource.wiki_link, class: "text-[var(--accent)] hover:underline", target: "_blank", rel: "noopener" %>
        <% else %>
          —
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Kappa Required</dt>
      <dd class="text-[var(--text)]"><%= @resource.kappa_required ? "Yes" : "No" %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Lightkeeper Required</dt>
      <dd class="text-[var(--text)]"><%= @resource.lightkeeper_required ? "Yes" : "No" %></dd>
    </div>
  </dl>
</div>
