<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Items (<%= @total_count %>)</h1>
  <%= link_to "New Item", [:new, :admin, :item], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "BSG ID", field: :bsg_id },
  { label: "Full Name", field: :full_name, truncate: 40 },
  { label: "Short Name", field: :short_name },
  { label: "Categories", field: :categories }
], @resources) %>

<%= render "admin/shared/pagination" %>
