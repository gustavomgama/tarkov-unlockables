<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Slots (<%= @total_count %>)</h1>
  <%= link_to "New Slot", [:new, :admin, :slot], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Property ID", field: :property_id },
  { label: "Name ID", field: :name_id },
  { label: "Required", field: :required }
], @resources) %>

<%= render "admin/shared/pagination" %>
