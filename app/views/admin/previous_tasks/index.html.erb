<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Previous Tasks (<%= @total_count %>)</h1>
  <%= link_to "New Previous Task", [:new, :admin, :previous_task], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Requirement ID", field: :requirement_id },
  { label: "Task ID", field: :task_id },
  { label: "Task Name", field: :task_name, truncate: 30 }
], @resources) %>

<%= render "admin/shared/pagination" %>
