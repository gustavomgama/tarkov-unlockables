<%= render "admin/shared/index_header", title: "Previous Tasks", new_label: "Previous Task",
                                        new_path: [:new, :admin, :previous_task], search_path: admin_previous_tasks_path,
                                        placeholder: "Search previous tasks..." %>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Requirement ID", field: :requirement_id },
  { label: "Task ID", field: :task_id },
  { label: "Task Name", field: :task_name, truncate: 30, link: true }
], @resources) %>

<%= render "admin/shared/pagination" %>
