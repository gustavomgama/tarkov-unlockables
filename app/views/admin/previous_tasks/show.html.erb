<%= render "admin/shared/back_link", path: [:admin, :previous_tasks] %>

<div class="bg-[var(--bg-panel)] p-6 border border-[var(--border)]">
  <h1 class="text-2xl font-bold text-[var(--text-bright)] mb-6">Previous Task #<%= @resource.id %></h1>
  <%= render "admin/shared/show_actions", edit_path: [:edit, :admin, @resource], destroy_path: [:admin, @resource] %>

  <dl class="grid grid-cols-2 gap-6">
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Requirement ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.requirement_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Task ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.task_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Task Name</dt>
      <dd class="text-[var(--text)]"><%= @resource.task_name %></dd>
    </div>
  </dl>

  <% if @resource.requirement && @resource.requirement.task %>
    <div class="mt-6 pt-6 border-t border-[var(--border)]">
      <h2 class="text-lg font-bold text-[var(--text-bright)] mb-2">Requirement</h2>
      <%= link_to "View Requirement", [:admin, @resource.requirement], class: "text-[var(--accent)] hover:underline" %>
    </div>
  <% end %>
</div>
