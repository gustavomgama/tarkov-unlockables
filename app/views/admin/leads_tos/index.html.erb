<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Leads To (<%= @total_count %>)</h1>
  <%= link_to "New LeadsTo", [:new, :admin, :leads_to], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Task ID", field: :task_id },
  { label: "Follow Up Task ID", field: :follow_up_task_id },
  { label: "Follow Up Task Name", field: :follow_up_task_name, truncate: 30 }
], @resources) %>

<%= render "admin/shared/pagination" %>
