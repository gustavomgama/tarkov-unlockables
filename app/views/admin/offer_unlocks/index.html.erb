<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Offer Unlocks (<%= @total_count %>)</h1>
  <%= link_to "New Offer Unlock", [:new, :admin, :offer_unlock], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Reward ID", field: :reward_id },
  { label: "Item Name", field: :item_name, truncate: 30 },
  { label: "Trader", field: :trader_name },
  { label: "Trader Level", field: :trader_level }
], @resources) %>

<%= render "admin/shared/pagination" %>
