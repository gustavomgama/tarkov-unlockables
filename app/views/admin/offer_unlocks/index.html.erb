<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Offer Unlocks (<%= @total_count %>)</h1>
  <%= link_to "New Offer Unlock", [:new, :admin, :offer_unlock], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= form_tag admin_offer_unlocks_path, method: :get, class: "mb-4 flex items-center gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search offer unlocks...", class: "flex-1 px-3 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] focus:outline-none" %>
  <button type="submit" class="px-4 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)]">
    Search
  </button>
<% end %>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Reward ID", field: :reward_id },
  { label: "Item Name", field: :item_name, truncate: 30, link: true },
  { label: "Trader", field: :trader_name },
  { label: "Trader Level", field: :trader_level }
], @resources) %>

<%= render "admin/shared/pagination" %>
