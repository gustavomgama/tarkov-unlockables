<div class="mb-4">
  <%= link_to "← Back", [:admin, :offer_unlocks], class: "text-[var(--accent)] hover:underline" %>
</div>

<div class="bg-[var(--bg-panel)] p-6 border border-[var(--border)]">
  <h1 class="text-2xl font-bold text-[var(--text-bright)] mb-6">Offer Unlock #<%= @resource.id %></h1>
  <div class="mb-6 flex gap-4">
    <%= link_to "Edit", [:edit, :admin, @resource], class: "px-4 py-2 bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:bg-[var(--bg-elevated)] transition-colors" %>
    <%= button_to "Delete", [:admin, @resource], method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-[var(--danger)] text-white hover:opacity-90" %>
  </div>

  <dl class="grid grid-cols-2 gap-6">
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Reward ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.reward_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Item ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.item_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Item Name</dt>
      <dd class="text-[var(--text)]"><%= @resource.item_name %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Trader Name</dt>
      <dd class="text-[var(--text)]"><%= @resource.trader_name %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Trader Level</dt>
      <dd class="text-[var(--text)]"><%= @resource.trader_level %></dd>
    </div>
  </dl>

  <% if @resource.reward && @resource.reward.task %>
    <div class="mt-6 pt-6 border-t border-[var(--border)]">
      <h2 class="text-lg font-bold text-[var(--text-bright)] mb-2">Task</h2>
      <%= link_to @resource.reward.task.full_name, [:admin, @resource.reward.task], class: "text-[var(--accent)] hover:underline" %>
    </div>
  <% end %>
</div>
