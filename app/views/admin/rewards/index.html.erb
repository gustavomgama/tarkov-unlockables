<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Rewards (<%= @total_count %>)</h1>
  <%= link_to "New Reward", [:new, :admin, :reward], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= form_tag admin_rewards_path, method: :get, class: "mb-4 flex items-center gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search rewards...", class: "flex-1 px-3 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] focus:outline-none" %>
  <button type="submit" class="px-4 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)]">
    Search
  </button>
<% end %>

<%= admin_table([
  { label: "ID", field: :id, link: true },
  { label: "Task ID", field: :task_id },
  { label: "Reward Type", field: :reward_type }
], @resources) %>

<%= render "admin/shared/pagination" %>
