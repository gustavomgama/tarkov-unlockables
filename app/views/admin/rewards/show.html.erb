<%= render "admin/shared/back_link", path: [:admin, :rewards] %>

<div class="bg-[var(--bg-panel)] p-6 border border-[var(--border)]">
  <h1 class="text-2xl font-bold text-[var(--text-bright)] mb-6">Reward #<%= @resource.id %></h1>
  <%= render "admin/shared/show_actions", edit_path: [:edit, :admin, @resource], destroy_path: [:admin, @resource] %>

  <dl class="grid grid-cols-2 gap-6">
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Task ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.task_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Reward Type</dt>
      <dd class="text-[var(--text)]"><%= @resource.reward_type %></dd>
    </div>
  </dl>

  <%= render "admin/shared/related_task", task: @resource.task %>
</div>
