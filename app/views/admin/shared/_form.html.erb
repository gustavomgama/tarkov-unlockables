<%= form_with model: [:admin, model], local: true, data: { turbo: false }, class: "max-w-2xl" do |form| %>
  <%= render "admin/shared/form_errors", model: model %>

  <div class="space-y-4">
    <% fields.each do |field| %>
      <% field_name = field.is_a?(Symbol) ? field : field[:name] %>
      <% field_type = field.is_a?(Hash) ? field[:type] : :text %>
      <% label = field.is_a?(Hash) && field[:label] ? field[:label] : field_name.to_s.humanize %>

      <div>
        <%= form.label field_name, label, class: "block text-sm text-[var(--text-muted)] mb-1" %>

        <% case field_type %>
        <% when :boolean %>
          <%= form.check_box field_name, class: "w-4 h-4" %>
        <% when :number %>
          <%= form.number_field field_name, class: "w-full bg-[var(--bg-surface)] border border-[var(--border)] p-2 text-[var(--text)]" %>
        <% when :text_area %>
          <%= form.text_area field_name, rows: 3, class: "w-full bg-[var(--bg-surface)] border border-[var(--border)] p-2 text-[var(--text)]" %>
        <% else %>
          <%= form.text_field field_name, class: "w-full bg-[var(--bg-surface)] border border-[var(--border)] p-2 text-[var(--text)]" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "admin/shared/form_actions", form: form, cancel_path: [:admin, model.class] %>
<% end %>
