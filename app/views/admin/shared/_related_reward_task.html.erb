<%# Link to the task behind an unlock's reward. Locals: reward %>
<% if reward&.task %>
  <div class="mt-6 pt-6 border-t border-[var(--border)]">
    <h2 class="text-lg font-bold text-[var(--text-bright)] mb-2">Task</h2>
    <%= link_to reward.task.full_name, [:admin, reward.task], class: "text-[var(--accent)] hover:underline" %>
  </div>
<% end %>
