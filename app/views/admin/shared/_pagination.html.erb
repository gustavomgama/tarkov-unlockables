<% if @total_pages > 1 %>
  <%
    # Preserve current query params (search, filters) across pagination links
    base_params = request.query_parameters.except("page")
  %>
  <div class="flex items-center justify-between mt-6">
    <div class="text-sm text-[var(--text-muted)]">
      Showing <%= ((@current_page - 1) * @per_page) + 1 %> to <%= [@current_page * @per_page, @total_count].min %> of <%= @total_count %> entries
    </div>
    <div class="flex gap-1">
      <%= render "admin/shared/page_link", label: "Previous", page: @current_page - 1,
                                            enabled: @current_page > 1, base_params: base_params %>

      <% 1.upto(@total_pages) do |p| %>
        <% if p == @current_page %>
          <span class="px-3 py-1 text-sm bg-[var(--accent)] text-[var(--bg-dark)] font-bold"><%= p %></span>
        <% elsif p <= 3 || p > @total_pages - 3 || (p - @current_page).abs <= 1 %>
          <%= link_to p, url_for(base_params.merge(page: p, per_page: @per_page)), class: "px-3 py-1 text-sm bg-[var(--bg-surface)] border border-[var(--border)] hover:bg-[var(--bg-elevated)]" %>
        <% elsif p == 4 && @current_page > 5 %>
          <span class="px-2 text-[var(--text-muted)]">...</span>
        <% elsif p == @total_pages - 3 && @current_page < @total_pages - 4 %>
          <span class="px-2 text-[var(--text-muted)]">...</span>
        <% end %>
      <% end %>

      <%= render "admin/shared/page_link", label: "Next", page: @current_page + 1,
                                            enabled: @current_page < @total_pages, base_params: base_params %>
    </div>
  </div>
<% end %>
