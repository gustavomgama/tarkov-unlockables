<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title>Admin // Tarkov DB</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "tailwind" %>
    <%= javascript_importmap_tags %>
    <style>
      :root {
        --bg-dark: #0a0a0a;
        --bg-panel: #12161c;
        --bg-surface: #1a1a1a;
        --bg-elevated: #22252a;
        --text: #e0e0e0;
        --text-bright: #ffffff;
        --text-muted: #888888;
        --accent: #d2af78;
        --accent-hover: #e6c58c;
        --border: #333333;
        --border-faint: rgba(255,255,255,0.08);
        --success: #00a700;
        --danger: #cd1e2f;
      }
      html { background-color: var(--bg-dark); }
      body {
        background-color: var(--bg-dark);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body class="min-h-screen flex">
    <aside class="w-56 bg-[var(--bg-panel)] border-r border-[var(--border)] flex-shrink-0 flex flex-col">
      <div class="p-4 border-b border-[var(--border)]">
        <%= link_to "Admin Panel", admin_root_path, class: "text-lg font-bold text-[var(--accent)]" %>
      </div>
      <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
        <div class="text-xs uppercase text-[var(--text-muted)] mb-2 px-3">Items</div>
        <%= admin_nav_link("Items", Item) %>
        <%= admin_nav_link("Properties", Property) %>
        <%= admin_nav_link("Slots", Slot) %>

        <div class="text-xs uppercase text-[var(--text-muted)] mt-4 mb-2 px-3">Tasks</div>
        <%= admin_nav_link("Tasks", Task) %>
        <%= admin_nav_link("Requirements", Requirement) %>
        <%= admin_nav_link("Rewards", Reward) %>
        <%= admin_nav_link("Leads To", LeadsTo) %>
        <%= admin_nav_link("Previous Tasks", PreviousTask) %>

        <div class="text-xs uppercase text-[var(--text-muted)] mt-4 mb-2 px-3">Barters</div>
        <%= admin_nav_link("Barter Unlocks", BarterUnlock) %>

        <div class="text-xs uppercase text-[var(--text-muted)] mt-4 mb-2 px-3">Crafts</div>
        <%= admin_nav_link("Craft Unlocks", CraftUnlock) %>

        <div class="text-xs uppercase text-[var(--text-muted)] mt-4 mb-2 px-3">Offers</div>
        <%= admin_nav_link("Offer Unlocks", OfferUnlock) %>
      </nav>
    </aside>

    <main class="flex-1 p-6 overflow-auto">
      <% if notice %>
        <div class="mb-4 p-3 bg-[var(--success)]/20 border border-[var(--success)] rounded text-[var(--success)] text-sm">
          <%= notice %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
