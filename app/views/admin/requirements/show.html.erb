<div class="mb-4">
  <%= link_to "← Back", [:admin, :requirements], class: "text-[var(--accent)] hover:underline" %>
</div>

<div class="bg-[var(--bg-panel)] p-6 rounded border border-[var(--border)]">
  <h1 class="text-2xl font-bold text-[var(--text-bright)] mb-6">Requirement #<%= @resource.id %></h1>

  <dl class="grid grid-cols-2 gap-6">
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Task ID</dt>
      <dd class="text-[var(--text)]"><%= @resource.task_id %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Player Level</dt>
      <dd class="text-[var(--text)]"><%= @resource.player_level %></dd>
    </div>
    <div>
      <dt class="text-[var(--text-muted)] text-sm">Previous Tasks Count</dt>
      <dd class="text-[var(--text)]"><%= @resource.previous_tasks_count %></dd>
    </div>
  </dl>

  <% if @resource.task %>
    <div class="mt-6 pt-6 border-t border-[var(--border)]">
      <h2 class="text-lg font-bold text-[var(--text-bright)] mb-2">Task</h2>
      <%= link_to @resource.task.full_name, [:admin, @resource.task], class: "text-[var(--accent)] hover:underline" %>
    </div>
  <% end %>

  <div class="mt-6 flex gap-4">
    <%= link_to "Edit", [:edit, :admin, @resource], class: "px-4 py-2 bg-[var(--bg-surface)] border border-[var(--border)] rounded text-[var(--text)] hover:bg-[var(--bg-elevated)] transition-colors" %>
    <%= button_to "Delete", [:admin, @resource], method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-[var(--danger)] text-white rounded hover:opacity-90" %>
  </div>
</div>
