<div class="mb-6 flex justify-between items-center">
  <h1 class="text-2xl font-bold text-[var(--text-bright)]">Requirements (<%= @total_count %>)</h1>
  <%= link_to "New Requirement", [:new, :admin, :requirement], class: "px-4 py-2 bg-[var(--accent)] text-[var(--bg-dark)] rounded font-bold hover:bg-[var(--accent-hover)] transition-colors" %>
</div>

<%= admin_table([
  { label: "ID", field: :id },
  { label: "Task ID", field: :task_id },
  { label: "Player Level", field: :player_level },
  { label: "Previous Tasks Count", field: :previous_tasks_count }
], @resources) %>

<%= render "admin/shared/pagination" %>
