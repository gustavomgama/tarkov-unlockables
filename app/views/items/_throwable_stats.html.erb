<% throw_type = item.data["type"].presence %>
<% effect = clean_wiki_text(item.data["effect"]) %>

<% if throw_type.present? %>
  <dl class="stats">
    <div class="stat <%= stat_scale(throw_type) %>">
      <dt class="stat__key">Type</dt>
      <dd class="stat__val"><%= throw_type.titleize %></dd>
    </div>
  </dl>
<% end %>

<% if effect.present? %>
  <dl class="stats">
    <div class="stat stat--wide">
      <dt class="stat__key">Effect</dt>
      <dd class="stat__val text-sm font-normal leading-relaxed whitespace-pre-line"><%= effect %></dd>
    </div>
  </dl>
<% end %>
