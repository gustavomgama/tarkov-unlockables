<%# Where to get: every acquisition route on file, one row per route.
    Task gating is flagged here but explained in the unlock panel, so the
    timeline is never rendered twice. %>
<% rewards  = item.item_task_rewards %>
<%# The import can repeat a row; the same offer twice is noise, not data. %>
<% traders  = item.item_currencies.uniq { |c| [ c.trader, c.currency, c.min_trader_level ] } %>
<% barters  = item.item_barters %>
<% hideouts = item.item_hideouts %>

<% if rewards.any? || traders.any? || barters.any? || hideouts.any? %>
  <div class="panel__body panel__body--flush">
    <% traders.each do |currency| %>
      <div class="srcrow">
        <span class="srcbadge" style="--tone: var(--badge-currency)">Trader</span>
        <div class="srcrow__body">
          <p class="srcrow__title">
            <span class="trader-dot inline-block align-middle mr-1.5" style="background: var(--trader-<%= currency.trader.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
            <%= currency.trader.titleize %> <span class="font-data text-[var(--text-muted)]">LL<%= currency.min_trader_level %></span>
            <% if currency.price.present? %>
              <span class="font-data text-[var(--text-bright)]"><%= number_with_delimiter(currency.price) %> <%= currency.currency %></span>
            <% elsif currency.currency.present? %>
              <span class="font-data text-[var(--text-muted)]">· <%= currency.currency %></span>
            <% end %>
          </p>
          <% if currency.buy_limit.present? %>
            <p class="srcrow__meta"><span class="font-data">Buy limit <%= currency.buy_limit %> per reset</span></p>
          <% end %>
          <% if currency.task_unlock? %>
            <p class="srcrow__meta">
              <span class="chip" style="--tone: var(--badge-task)">Task-gated</span>
              <% if currency.task %>
                unlocked by <%= link_to currency.task.full_name, task_path(currency.task) %>
              <% else %>
                unlocked by a task — see the unlock path on this page
              <% end %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>

    <% barters.each do |barter| %>
      <div class="srcrow">
        <span class="srcbadge" style="--tone: var(--badge-barter)">Barter</span>
        <div class="srcrow__body">
          <p class="srcrow__title">
            <span class="trader-dot inline-block align-middle mr-1.5" style="background: var(--trader-<%= barter.trader.to_s.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
            <%= barter.trader.presence&.titleize || "Unknown trader" %>
            <span class="font-data text-[var(--text-muted)]">LL<%= barter.trader_level %></span>
            <% if barter.count.to_i > 1 %>
              <span class="font-data text-[var(--text-bright)]">×<%= barter.count %></span>
            <% end %>
          </p>
          <% required = barter.item_barter_requirements %>
          <% if required.any? %>
            <p class="srcrow__meta">for <%= required.map { |r| "#{r.item_name} ×#{r.count}" }.to_sentence %></p>
          <% end %>
          <% if barter.buy_limit.present? %>
            <p class="srcrow__meta"><span class="font-data">Buy limit <%= barter.buy_limit %> per reset</span></p>
          <% end %>
          <% if barter.task %>
            <p class="srcrow__meta">unlocked by <%= link_to barter.task.full_name, task_path(barter.task) %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <% hideouts.each do |hideout| %>
      <div class="srcrow">
        <span class="srcbadge" style="--tone: var(--badge-hideout)">Hideout</span>
        <div class="srcrow__body">
          <p class="srcrow__title">
            <%= link_to hideout.station, station_path(hideout.station.to_s.parameterize) %>
            <span class="font-data text-[var(--text-muted)]">Level <%= hideout.level %></span>
            <% if hideout.count.to_i > 1 %>
              <span class="font-data text-[var(--text-bright)]">×<%= hideout.count %></span>
            <% end %>
          </p>
          <% required = hideout.item_hideout_requirements %>
          <% needs = required.reject(&:is_tool) %>
          <% tools = required.select(&:is_tool) %>
          <% if needs.any? %>
            <p class="srcrow__meta">needs <%= needs.map { |r| "#{r.item_name} ×#{r.count}" }.to_sentence %></p>
          <% end %>
          <% if tools.any? %>
            <p class="srcrow__meta">tools needed: <%= tools.map(&:item_name).to_sentence %></p>
          <% end %>
          <% if hideout.duration.present? %>
            <p class="srcrow__meta"><span class="font-data"><%= distance_of_time_in_words(hideout.duration) %></span></p>
          <% end %>
          <% if hideout.task %>
            <p class="srcrow__meta">unlocked by <%= link_to hideout.task.full_name, task_path(hideout.task) %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <% rewards.each do |reward| %>
      <div class="srcrow">
        <span class="srcbadge" style="--tone: var(--badge-task)">Quest</span>
        <div class="srcrow__body">
          <p class="srcrow__title">
            <% task = reward.task || task_map[reward.task_name] %>
            <% if task %>
              <%= link_to task_display_name(reward.task_name), task_path(task) %>
            <% else %>
              <%= task_display_name(reward.task_name) %>
            <% end %>
          </p>
          <p class="srcrow__meta">quest reward</p>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="panel__body">
    <p class="text-sm text-[var(--text-muted)]">
      No trader, barter or quest route recorded. This item may only drop in raid.
    </p>
  </div>
<% end %>
