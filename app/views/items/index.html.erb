<% content_for :title, "Items" %>
<% active_filters = params[:filters].to_unsafe_h.deep_symbolize_keys rescue {} %>
<% has_filters = active_filters.present? %>

<div class="space-y-4 sm:space-y-5" data-controller="view-toggle">
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <h1 class="text-xl sm:text-2xl font-bold text-[var(--text-bright)]">Items</h1>
    <p class="font-data text-sm text-[var(--text-muted)]">
      <span class="text-[var(--text)]"><%= number_with_delimiter(@item_count) %></span> items
      <% if @total_pages > 1 %>· page <%= @current_page %>/<%= @total_pages %><% end %>
    </p>
  </div>

  <%= form_tag items_path, method: :get, id: "filter-form", class: "space-y-3 no-print",
      data: { controller: "filter-form" } do %>
    <%# Toolbar: search, page size, view. %>
    <div class="flex flex-wrap items-center gap-2">
      <div class="relative flex-1 min-w-[10rem]"
           data-controller="search"
           data-search-url-value="<%= search_items_path %>"
           data-action="keydown->search#keydown">
        <%= text_field_tag :q, params[:q], type: "search", placeholder: "Search by name…",
              class: "input", "aria-label": "Search items",
              autocomplete: "off",
              role: "combobox",
              "aria-expanded": "false",
              "aria-controls": "search-results",
              "aria-autocomplete": "list",
              data: { search_target: "input", action: "input->search#query" } %>

        <div
          id="search-results"
          class="hidden absolute left-0 right-0 top-full z-50 mt-1 max-h-96 overflow-y-auto bg-[var(--bg-surface)] border border-[var(--border)]"
          data-search-target="results"
          role="status"
          aria-live="polite"
          aria-label="Search results"
        ></div>
      </div>

      <%= select_tag :per_page, options_for_select([ 20, 50, 100 ], @per_page || 20),
            class: "input w-auto", "aria-label": "Items per page",
            data: { action: "change->filter-form#submit" } %>

      <div class="flex gap-px bg-[var(--border)] border border-[var(--border)] p-px">
        <button type="button" data-view-toggle-target="button" data-action="view-toggle#toggle" data-view="grid"
                aria-pressed="false"
                class="px-3 min-h-[2.5rem] text-xs font-bold text-[var(--text-muted)] hover:text-[var(--accent)] aria-pressed:text-[var(--accent)]">Grid</button>
        <button type="button" data-view-toggle-target="button" data-action="view-toggle#toggle" data-view="table"
                aria-pressed="false"
                class="px-3 min-h-[2.5rem] text-xs font-bold text-[var(--text-muted)] hover:text-[var(--accent)] aria-pressed:text-[var(--accent)]">Table</button>
      </div>
    </div>

    <%# Filters: one row of dropdowns, thumb-sized targets. %>
    <div class="flex flex-wrap items-center gap-2">
      <%= render FilterComponent::GroupComponent.new(
        title: "Currency", name: "currency",
        options: @filter_options[:currency],
        selected: Array(params.dig(:filters, :currency))
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Category", name: "category",
        options: @filter_options[:category],
        selected: Array(params.dig(:filters, :category))
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Armor class", name: "armor_class",
        options: @filter_options[:armor_class],
        selected: Array(params.dig(:filters, :armor_class))
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Caliber", name: "caliber",
        options: @filter_options[:caliber],
        selected: Array(params.dig(:filters, :caliber))
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Source", name: "source",
        options: @filter_options[:source],
        selected: Array(params.dig(:filters, :source))
      ) %>

      <label class="flex items-center gap-2 px-3 py-2 min-h-[2.5rem] text-sm bg-[var(--bg-surface)] border border-[var(--border)] hover:border-[var(--accent)] cursor-pointer">
        <input
          type="checkbox"
          name="filters[exclude_ref][]"
          value="1"
          <%= "checked" if Array(params.dig(:filters, :exclude_ref)).include?("1") %>
          data-action="change->filter-form#submit"
          class="border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)]"
        >
        <span class="text-[var(--text)]">Exclude Ref</span>
      </label>

      <%# Without JavaScript the filters open but cannot auto-submit. %>
      <noscript>
        <button type="submit" class="btn">Apply filters</button>
      </noscript>

      <% if has_filters || params[:q].present? %>
        <%= link_to "Clear all", items_path(per_page: @per_page), class: "text-sm text-[var(--danger)] hover:underline px-2 py-2" %>
      <% end %>
    </div>

    <%# Active filter pills, each removable in one tap. %>
    <% if has_filters %>
      <div class="flex flex-wrap items-center gap-1.5">
        <% active_filters.each do |filter_type, values| %>
          <% Array(values).each do |value| %>
            <% next if filter_type.to_s == "exclude_ref" %>
            <span class="chip chip--strong">
              <%= filter_type.to_s.humanize %>: <%= filter_value_label(filter_type, value) %>
              <%= link_to "×", items_path(q: params[:q], per_page: @per_page, filters: active_filters.except(filter_type).merge(filter_type => Array(values) - [ value ])),
                    class: "ml-1 text-[var(--text-muted)] hover:text-[var(--danger)] no-underline",
                    "aria-label": "Remove filter #{filter_type} #{value}" %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @items.none? %>
    <% reason = if @item_count.positive? then :page elsif has_filters then :filters else :search end %>
    <%= render "items/empty_state", reason: reason, total_pages: @total_pages %>
  <% else %>
    <div data-view-toggle-target="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-2.5 sm:gap-3">
      <%= render partial: "items/item_card", collection: @items, as: :card %>
    </div>

    <div data-view-toggle-target="table" class="hidden overflow-x-auto border border-[var(--border)]" tabindex="0" role="region" aria-label="Items, table view">
      <table class="w-full text-sm">
        <caption class="sr-only">Items matching the current search and filters</caption>
        <thead class="bg-[var(--bg-panel)]">
          <tr class="text-left text-[0.625rem] uppercase tracking-widest text-[var(--text-muted)]">
            <th scope="col" class="px-3 py-2 font-normal">Name</th>
            <th scope="col" class="px-3 py-2 font-normal">Short name</th>
            <th scope="col" class="px-3 py-2 font-normal">Type</th>
            <th scope="col" class="px-3 py-2 font-normal">Categories</th>
          </tr>
        </thead>
        <tbody>
          <% @items.each do |item| %>
            <tr class="border-t border-[var(--border)] hover:bg-[var(--bg-elevated)]">
              <td class="px-3 py-2"><%= link_to item.full_name, item_path(item) %></td>
              <td class="px-3 py-2 font-data text-[var(--text-muted)]"><%= item.short_name %></td>
              <td class="px-3 py-2 text-[var(--text-muted)]"><%= item.class.name.demodulize.titleize %></td>
              <td class="px-3 py-2 text-[var(--text-muted)]"><%= category_labels(item, limit: 3).join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <% safe_filters = active_filters %>
      <nav class="no-print flex items-center justify-between gap-3" aria-label="Pagination">
        <%= link_to "← Previous",
              items_path(page: @current_page - 1, q: params[:q], per_page: @per_page, filters: safe_filters),
              class: "btn #{'opacity-40 pointer-events-none' if @current_page == 1}" %>
        <span class="font-data text-sm text-[var(--text-muted)]">Page <%= @current_page %> of <%= number_with_delimiter(@total_pages) %></span>
        <%= link_to "Next →",
              items_path(page: @current_page + 1, q: params[:q], per_page: @per_page, filters: safe_filters),
              class: "btn #{'opacity-40 pointer-events-none' if @current_page == @total_pages}" %>
      </nav>
    <% end %>
  <% end %>
</div>
