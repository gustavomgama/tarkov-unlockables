<div class="space-y-6" data-controller="view-toggle">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-[var(--text-bright)]">Items</h1>
    <div class="flex items-center gap-4">
      <span class="text-sm text-[var(--text-muted)]"><%= @item_count %> total</span>
      <div class="flex gap-1 bg-[var(--bg-surface)] p-1">
        <button
          type="button"
          data-action="view-toggle#toggle"
          data-view="grid"
          class="px-3 py-1 text-sm text-[var(--text)] hover:text-[var(--accent)] transition-colors"
        >
          Grid
        </button>
        <button
          type="button"
          data-action="view-toggle#toggle"
          data-view="table"
          class="px-3 py-1 text-sm text-[var(--text)] hover:text-[var(--accent)] transition-colors"
        >
          Table
        </button>
      </div>
    </div>
  </div>

  <%= form_tag items_path, method: :get, class: "flex items-center gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search items...", class: "flex-1 px-3 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] focus:outline-none" %>
    <% if params[:filters].present? %>
      <% params[:filters].each do |filter_type, values| %>
        <% Array(values).each do |value| %>
          <%= hidden_field_tag "filters[#{filter_type}][]", value %>
        <% end %>
      <% end %>
    <% end %>
    <button type="submit" class="px-4 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)]">
      Search
    </button>
  <% end %>

  <form id="filter-form" action="<%= items_path %>" method="get">
    <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
    <% if params[:filters].present? %>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm text-[var(--text-muted)]">Active filters:</span>
        <% params[:filters].each do |filter_type, values| %>
          <% Array(values).each do |value| %>
            <span class="inline-flex items-center gap-1 px-2 py-1 text-sm bg-[var(--bg-surface)] text-[var(--text)]">
              <%= filter_type.humanize %>: <%= value %>
              <%= link_to "×", items_path(q: params[:q], filters: params[:filters].except(filter_type).merge(filter_type => Array(values) - [value])), class: "ml-1 hover:text-[var(--text-bright)]" %>
            </span>
          <% end %>
        <% end %>
        <%= link_to "Clear all", items_path(q: params[:q]), class: "text-sm text-[var(--danger)] hover:underline" %>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-2">
      <%= render FilterComponent::GroupComponent.new(
        title: "Currency",
        name: "currency",
        options: @filter_options[:currency],
        selected: params.dig(:filters, :currency) || []
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Category",
        name: "category",
        options: @filter_options[:category],
        selected: params.dig(:filters, :category) || []
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Armor Class",
        name: "armor_class",
        options: @filter_options[:armor_class],
        selected: params.dig(:filters, :armor_class) || []
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Caliber",
        name: "caliber",
        options: @filter_options[:caliber],
        selected: params.dig(:filters, :caliber) || []
      ) %>

      <%= render FilterComponent::GroupComponent.new(
        title: "Source",
        name: "source",
        options: @filter_options[:source],
        selected: params.dig(:filters, :source) || []
      ) %>

      <% if params[:filters].present? %>
        <%= link_to items_path(q: params[:q]), class: "px-3 py-2 text-sm text-[var(--danger)] border border-[var(--border)]" do %>
          Clear filters
        <% end %>
      <% end %>
    </div>
  </form>

  <div data-view-toggle-target="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
    <%= render partial: "items/item_card", collection: @items, as: :card %>
  </div>

  <div data-view-toggle-target="table" class="hidden overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-[var(--bg-surface)]">
        <tr>
          <th class="px-4 py-3 text-left font-medium text-[var(--text-muted)]">Name</th>
          <th class="px-4 py-3 text-left font-medium text-[var(--text-muted)]">Short Name</th>
          <th class="px-4 py-3 text-left font-medium text-[var(--text-muted)]">Categories</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        <% @items.each do |item| %>
          <tr class="hover:bg-[var(--bg-surface)]">
            <td class="px-4 py-3">
              <%= link_to item.full_name, item_path(item), class: "text-[var(--accent)] hover:text-[var(--accent-hover)]" %>
            </td>
            <td class="px-4 py-3 text-[var(--text)]"><%= item.short_name %></td>
            <td class="px-4 py-3 text-[var(--text)]"><%= item.categories.join(", ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @total_pages > 1 %>
    <nav class="flex items-center justify-center gap-2">
      <%= link_to "Previous", items_path(page: @current_page - 1, q: params[:q], filters: params[:filters]), class: "px-3 py-2 text-sm border border-[var(--border)] text-[var(--text)] #{@current_page == 1 ? 'opacity-50 pointer-events-none' : 'hover:border-[var(--accent)]'}" %>
      <span class="px-3 py-2 text-sm text-[var(--text-muted)]">Page <%= @current_page %> of <%= @total_pages %></span>
      <%= link_to "Next", items_path(page: @current_page + 1, q: params[:q], filters: params[:filters]), class: "px-3 py-2 text-sm border border-[var(--border)] text-[var(--text)] #{@current_page == @total_pages ? 'opacity-50 pointer-events-none' : 'hover:border-[var(--accent)]'}" %>
    </nav>
  <% end %>
</div>

<script>
document.querySelectorAll('.filter-checkbox').forEach(function(checkbox) {
  checkbox.addEventListener('change', function() {
    document.getElementById('filter-form').submit();
  });
});
</script>
