<dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
  <% if item.data["caliber"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Caliber</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["caliber"] %></dd>
    </div>
  <% end %>
  <% if item.data["damage"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Damage</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["damage"] %></dd>
    </div>
  <% end %>
  <% if item.data["penetration_power"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Penetration</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["penetration_power"] %></dd>
    </div>
  <% end %>
  <% if item.data["ammo_type"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Ammo Type</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["ammo_type"] %></dd>
    </div>
  <% end %>
  <% if item.data["stack_max_size"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Stack Max Size</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["stack_max_size"] %></dd>
    </div>
  <% end %>
  <% if item.data["tracer"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Tracer</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["tracer"] %></dd>
    </div>
  <% end %>
  <% if item.data["tracer_color"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Tracer Color</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["tracer_color"] %></dd>
    </div>
  <% end %>
</dl>
