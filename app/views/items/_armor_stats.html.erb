<% armor_class = item.data["class"] %>
<% armor_type = item.data["armor_type"].presence %>
<% durability = item.data["max_uses"].presence %>

<dl class="stats">
  <% if armor_class.present? %>
    <div class="stat stat--xl stat--tone" style="--tone: <%= armor_class_tone(armor_class) %>">
      <dt class="stat__key">Armor Class</dt>
      <dd class="stat__val"><%= armor_class %></dd>
      <dd class="stat__note">out of 6</dd>
    </div>
  <% end %>

  <% if durability.present? %>
    <div class="stat">
      <dt class="stat__key">Durability</dt>
      <dd class="stat__val"><%= durability %></dd>
    </div>
  <% end %>

  <% if item.data["slot"].present? %>
    <div class="stat">
      <dt class="stat__key">Slot</dt>
      <dd class="stat__val"><%= item.data["slot"].titleize %></dd>
    </div>
  <% end %>
</dl>

<% if armor_class.present? %>
  <div class="stat stat--wide">
    <span class="stat__key">Protection by armor class</span>
    <%= render "items/armor_scale", scale: armor_scale(armor_class), tone: armor_class_tone(armor_class),
            label: "Protects against armor classes 1 through #{armor_class.to_i.clamp(1, 6)}" %>
    <%= render "items/armor_class_note", kind: :protection %>
  </div>
<% end %>

<% if armor_type.present? %>
  <dl class="specs">
    <div class="spec">
      <dt class="spec__key">Armor Type</dt>
      <dd class="spec__val"><%= armor_type %></dd>
    </div>
  </dl>
<% end %>
