<%# Armor-class ladder: six blocks, lit up to the rating.
    Reads as a picture, so it gets one text alternative rather than six bare
    numbers announced in sequence.
    Locals:
      scale — Array<Boolean> of length 6 (true = lit)
      tone  — CSS colour value shared by every lit block
      label — screen-reader description of what the lit blocks mean %>
<div class="ac-grid" style="--tone: <%= tone %>" role="img" aria-label="<%= label %>">
  <% scale.each_with_index do |lit, i| %>
    <div class="ac-cell <%= "ac-cell--on" if lit %>" aria-hidden="true"><%= i + 1 %></div>
  <% end %>
</div>
