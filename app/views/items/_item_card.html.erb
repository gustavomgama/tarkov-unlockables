<%= link_to item_path(card), class: "card" do %>
  <div class="card__media">
    <% largest_img = card.images.find { |img| img.include?("512") } || card.images.find { |img| img.include?("8x") } || card.images.first %>
    <% if largest_img.present? %>
      <img
        src="<%= largest_img %>"
        alt=""
        class="card__img"
        loading="lazy"
        width="200"
        height="150"
      >
    <% end %>
  </div>
  <div class="card__body">
    <h3 class="card__name"><%= card.full_name %></h3>

    <% stats = card_stats(card) %>
    <% if stats.any? %>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 font-data text-[0.6875rem]">
        <% stats.each do |label, value, tone| %>
          <span class="flex items-baseline gap-1">
            <span class="text-[var(--text-muted)]"><%= label %></span>
            <span class="font-bold" style="<%= "color: #{tone}" if tone %>"><%= value %></span>
          </span>
        <% end %>
      </div>
    <% end %>

    <% chips = category_chips(card) %>
    <% if chips.any? %>
      <div class="mt-1.5 flex flex-wrap gap-1">
        <% chips.each do |label| %>
          <span class="chip"><%= label %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
