<%= link_to item_path(card), class: "group block bg-[var(--bg-surface)] border border-[var(--border)] border-l-2 border-l-[var(--accent)] overflow-hidden hover:border-[var(--accent)] transition-colors" do %>
  <div class="aspect-square bg-[var(--bg-panel)] overflow-hidden">
    <% largest_img = card.images.find { |img| img.include?('512') } || card.images.find { |img| img.include?('8x') } || card.images.first %>
    <img
      src="<%= largest_img || "https://via.placeholder.com/150" %>"
      alt="<%= card.full_name %>"
      class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
      width="150"
      height="150"
    >
  </div>
  <div class="p-3">
    <h3 class="font-semibold text-sm line-clamp-2 mb-1.5 text-[var(--text-bright)]"><%= card.full_name %></h3>
    <div class="flex flex-wrap gap-1">
      <% card.categories.first(2).each do |cat| %>
        <span class="inline-block px-1.5 py-0.5 text-xs bg-[var(--bg-elevated)] text-[var(--text-muted)] border border-[var(--border)]">
          <%= cat.humanize %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
