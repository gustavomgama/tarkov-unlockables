<%# The first card of a collection is the likely LCP element, so it loads
    eagerly. `card_counter` only exists for a collection render; a single
    render passes :priority instead. %>
<% priority = local_assigns.fetch(:priority) { defined?(card_counter) && card_counter.zero? } %>
<%= link_to item_path(card), class: "card" do %>
  <div class="card__media">
    <%= render "items/image", item: card, priority: priority %>
  </div>
  <div class="card__body">
    <h2 class="card__name"><%= card.full_name %></h2>

    <% stats = card_stats(card) %>
    <% if stats.any? %>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 font-data text-[0.6875rem]">
        <% stats.each do |label, value, tone| %>
          <span class="flex items-baseline gap-1">
            <span class="text-[var(--text-muted)]"><%= label %></span>
            <span class="font-bold" style="<%= "color: #{tone}" if tone %>"><%= value %></span>
          </span>
        <% end %>
      </div>
    <% end %>

    <% if task_gated_item_ids([ card ])[card.id] %>
      <div class="mt-1.5">
        <span class="chip" style="--tone: var(--badge-task); background: var(--badge-task); color: var(--text-bright)">Task-gated</span>
      </div>
    <% end %>

    <% chips = category_chips(card) %>
    <% if chips.any? %>
      <div class="mt-1.5 flex flex-wrap gap-1">
        <% chips.each do |label| %>
          <span class="chip"><%= label %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
