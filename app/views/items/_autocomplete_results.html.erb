<%# One row per match, rendered by ItemsController#search and injected into the
    search panel by the search Stimulus controller. Links, not ARIA options:
    a list of destinations needs no combobox plumbing to be usable.
    Locals: items — the matched collection (already limited and ordered) %>
<% items.each do |item| %>
  <%= link_to item_path(item), class: "flex items-center gap-3 px-3 py-2 hover:bg-[var(--bg-elevated)] no-underline border-b border-[var(--border)] last:border-b-0" do %>
    <span class="w-8 h-8 shrink-0 bg-[var(--bg-panel)] border border-[var(--border)]">
      <%= render "items/image", item: item %>
    </span>
    <span class="flex-1 min-w-0">
      <span class="block text-sm font-bold truncate text-[var(--text-bright)]"><%= item.full_name %></span>
      <% if item.short_name.present? %>
        <span class="block text-xs text-[var(--text-muted)] truncate"><%= item.short_name %></span>
      <% end %>
    </span>
    <% if (label = category_labels(item, limit: 1).first) %>
      <span class="chip shrink-0"><%= label %></span>
    <% end %>
  <% end %>
<% end %>
