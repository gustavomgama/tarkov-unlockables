<%= link_to item_path(item), class: "flex items-center gap-3 px-4 py-2 hover:bg-[var(--bg-elevated)]" do %>
  <% largest_img = item.images.find { |img| img.include?('512') } || item.images.find { |img| img.include?('8x') } || item.images.first %>
  <img
    src="<%= largest_img || "https://via.placeholder.com/32" %>"
    alt=""
    class="w-8 h-8 object-contain bg-[var(--bg-panel)]"
  >
  <div class="flex-1 min-w-0">
    <p class="font-medium text-sm truncate text-[var(--text-bright)]"><%= item.full_name %></p>
    <p class="text-xs text-[var(--text-muted)] truncate"><%= item.short_name %></p>
  </div>
  <% if item.categories.any? %>
    <span class="text-xs text-[var(--text-muted)]"><%= item.categories.first.humanize %></span>
  <% end %>
<% end %>
