<% capacity = item.data["capacity"].presence || magazine_capacity(item) %>
<% caliber = caliber_label(item.data["caliber"]) %>

<dl class="stats">
  <% if capacity %>
    <div class="stat stat--xl">
      <dt class="stat__key">Capacity</dt>
      <dd class="stat__val"><%= capacity %></dd>
      <dd class="stat__note">rounds</dd>
    </div>
  <% end %>

  <% if caliber.present? %>
    <div class="stat <%= stat_scale(caliber, limit: 10) if capacity.nil? %>">
      <dt class="stat__key">Caliber</dt>
      <dd class="stat__val"><%= caliber %></dd>
    </div>
  <% end %>
</dl>
