<% effect = clean_wiki_text(item.data["effect"]) %>
<% default = item.data["default"].presence %>
<% if effect.present? || default.present? %>
  <% if default.present? %>
    <dl class="stats">
      <div class="stat stat--xl">
        <dt class="stat__key">Default Container</dt>
        <dd class="stat__val"><%= default == true ? "Yes" : default %></dd>
      </div>
    </dl>
  <% end %>
  <% if effect.present? %>
    <dl class="stats">
      <div class="stat stat--wide">
        <dt class="stat__key">Effect</dt>
        <dd class="stat__val text-sm font-normal leading-relaxed whitespace-pre-line"><%= effect %></dd>
      </div>
    </dl>
  <% end %>
<% end %>
