<dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
  <% if item.data["default"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Default Container</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["default"] %></dd>
    </div>
  <% end %>
  <% if item.data["size_width"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Width</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["size_width"] %></dd>
    </div>
  <% end %>
  <% if item.data["size_height"].present? %>
    <div>
      <dt class="text-[var(--text-muted)]">Height</dt>
      <dd class="font-medium text-[var(--text)]"><%= item.data["size_height"] %></dd>
    </div>
  <% end %>
</dl>
