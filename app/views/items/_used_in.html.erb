<%# What this item is worth: the barters and crafts it feeds. The other half
    of "should I keep this", and the question the item page could not answer.
    Locals: item, barters, crafts (requirement rows). Capped because one item
    (GP coin) feeds hundreds of barters. %>
<% limit = 12 %>

<div class="panel__body panel__body--flush">
  <% barters.first(limit).each do |entry| %>
    <% barter = entry.item_barter %>
    <div class="srcrow">
      <span class="srcbadge" style="--tone: var(--badge-barter)">Barter</span>
      <div class="srcrow__body">
        <p class="srcrow__title">
          gives <%= link_to barter.item.full_name, item_path(barter.item) %>
          <% if barter.count.to_i > 1 %>
            <span class="font-data text-[var(--text-bright)]">×<%= barter.count %></span>
          <% end %>
        </p>
        <p class="srcrow__meta">
          <span class="trader-dot inline-block align-middle mr-1.5" style="background: var(--trader-<%= barter.trader.to_s.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
          <%= barter.trader.presence&.titleize || "Unknown trader" %>
          <span class="font-data">LL<%= barter.trader_level %></span>
          · needs <span class="font-data"><%= entry.count || 1 %></span> × <%= item.short_name.presence || item.full_name %>
          <% if barter.task %>
            · unlocked by <%= link_to barter.task.full_name, task_path(barter.task) %>
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
  <% if barters.size > limit %>
    <p class="px-4 py-3 text-xs text-[var(--text-muted)]">and <%= barters.size - limit %> more barters.</p>
  <% end %>

  <% crafts.first(limit).each do |entry| %>
    <% craft = entry.item_hideout %>
    <div class="srcrow">
      <span class="srcbadge" style="--tone: var(--badge-craft)">Craft</span>
      <div class="srcrow__body">
        <p class="srcrow__title">
          crafts into <%= link_to craft.item.full_name, item_path(craft.item) %>
          <% if craft.count.to_i > 1 %>
            <span class="font-data text-[var(--text-bright)]">×<%= craft.count %></span>
          <% end %>
        </p>
        <p class="srcrow__meta">
          <% if craft.station.present? %>
            <%= craft.station %> <span class="font-data">Lv.<%= craft.level %></span> ·
          <% end %>
          needs <span class="font-data"><%= entry.count || 1 %></span> × <%= item.short_name.presence || item.full_name %>
          <% if entry.is_tool %>
            <span class="text-[var(--text-muted)]">(tool, not consumed)</span>
          <% end %>
          <% if craft.task %>
            · unlocked by <%= link_to craft.task.full_name, task_path(craft.task) %>
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
  <% if crafts.size > limit %>
    <p class="px-4 py-3 text-xs text-[var(--text-muted)]">and <%= crafts.size - limit %> more crafts.</p>
  <% end %>
</div>
