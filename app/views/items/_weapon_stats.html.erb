<% ergonomics = item.data["ergonomics"].presence %>
<% recoil = item.data["recoil"].presence %>
<% range = item.data["range"].presence %>
<% velocity = item.data["velocity"].presence %>
<% default_preset = bsg_item(item.data["default_preset"].presence || item.data["defaultPreset"]) %>
<% default_ammo_raw = item.data["default_ammo"].presence || item.data["def_ammo"] %>
<% default_ammo = bsg_item(default_ammo_raw) %>
<% accepted = compatible_ammo(item) %>
<% top_round = accepted.max_by { |a| a.data["penetration_power"].to_i } %>
<% top_round = nil if top_round == default_ammo %>
<% mod_slots = Array(item.data["mods"]).select { |m| m.is_a?(Hash) }
                                      .filter_map { |m| m["slot"].presence && [ m["slot"], Array(m["items"]).size ] } %>
<% caliber = item_caliber(item) %>

<dl class="stats">
  <% if caliber.present? %>
    <div class="stat stat--xl">
      <dt class="stat__key">Caliber</dt>
      <dd class="stat__val"><%= caliber %></dd>
    </div>
  <% end %>

  <% if top_round %>
    <% pen = top_round.data["penetration_power"] %>
    <div class="stat stat--tone" style="--tone: <%= penetration_tone(pen) %>">
      <dt class="stat__key">Best round</dt>
      <dd class="stat__val text-sm"><%= link_to top_round.short_name.presence || top_round.full_name, item_path(top_round) %></dd>
      <dd class="stat__note">pen <%= pen %><% if pen.present? %> · beats class <%= penetration_class(pen) %><% end %></dd>
    </div>
  <% end %>

  <% if default_ammo || default_ammo_raw %>
    <div class="stat">
      <dt class="stat__key">Default Ammo</dt>
      <dd class="stat__val text-sm">
        <% if default_ammo %>
          <%= link_to default_ammo.full_name, item_path(default_ammo) %>
        <% else %>
          <%# Import carries a display name instead of a bsg_id here. %>
          <%= default_ammo_raw %>
        <% end %>
      </dd>
    </div>
  <% end %>

  <% if ergonomics.present? && ergonomics.to_f.nonzero? %>
    <div class="stat">
      <dt class="stat__key">Ergonomics</dt>
      <dd class="stat__val">
        <%= ergonomics %>
        <span class="mt-1.5 block meter">
          <span class="meter__fill" style="--tone: var(--ac3); width: <%= ergonomics.to_f.clamp(0, 100) %>%"></span>
        </span>
      </dd>
    </div>
  <% end %>

  <% if recoil.present? && recoil.to_f.nonzero? %>
    <div class="stat">
      <dt class="stat__key">Recoil</dt>
      <dd class="stat__val"><%= recoil %></dd>
      <dd class="stat__note">lower is better</dd>
    </div>
  <% end %>

  <% if range.present? %>
    <div class="stat">
      <dt class="stat__key">Range</dt>
      <dd class="stat__val"><%= range %></dd>
    </div>
  <% end %>
</dl>

<% if mod_slots.any? %>
  <div class="stat stat--wide">
    <span class="stat__key">Mod slots &amp; compatible parts</span>
    <span class="stat__val flex flex-wrap gap-1 pt-0.5">
      <% mod_slots.first(12).each do |slot, count| %>
        <span class="chip chip--strong"><%= slot.to_s.titleize %> <span class="font-data text-[var(--text-muted)]"><%= count %></span></span>
      <% end %>
      <% if mod_slots.size > 12 %>
        <span class="chip">+<%= mod_slots.size - 12 %> more</span>
      <% end %>
    </span>
  </div>
<% end %>

<% if velocity.present? || default_preset %>
  <dl class="specs">
    <% if default_preset %>
      <div class="spec">
        <dt class="spec__key">Default preset</dt>
        <dd class="spec__val"><%= link_to default_preset.full_name, item_path(default_preset) %></dd>
      </div>
    <% end %>
    <% if velocity.present? %>
      <div class="spec">
        <dt class="spec__key">Muzzle Velocity</dt>
        <dd class="spec__val"><%= velocity %> m/s</dd>
      </div>
    <% end %>
  </dl>
<% end %>
