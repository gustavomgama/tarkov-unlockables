<%# The item's image, or a readable stand-in. An empty bordered box tells the
    reader nothing, so a missing image falls back to the short name.
    Locals: item, size (:card | :hero), priority (eager first card image) %>
<% size ||= :card %>
<% priority ||= false %>
<% eager = size == :hero || priority %>
<% largest = item.images.find { |img| img.include?("512") } || item.images.find { |img| img.include?("8x") } || item.images.last %>

<% if largest.present? %>
  <img
    src="<%= largest %>"
    alt=""
    class="<%= size == :hero ? "w-full h-full object-contain" : "card__img" %>"
    width="<%= size == :hero ? 160 : 200 %>"
    height="<%= size == :hero ? 160 : 150 %>"
    decoding="async"
    <%= eager ? 'fetchpriority="high"'.html_safe : 'loading="lazy"'.html_safe %>
  >
<% else %>
  <span class="flex h-full w-full items-center justify-center px-1 text-center font-data text-[0.6875rem] leading-tight text-[var(--text-muted)]">
    <%= item.short_name.presence || item.full_name.to_s.first(12) %>
  </span>
<% end %>
