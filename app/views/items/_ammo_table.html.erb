<%# Ammo comparison. A real table: each row is a round, the round name is the
    row header and the numbers are cells, so a screen reader reads "M855A1,
    damage 49, penetration 44" rather than a run of loose spans.
    Locals:
      ammo    — collection of Item::Ammo, already ordered
      title   — panel heading (also names the table)
      note    — optional one-line explanation under the table
      current — optional item to highlight as the one being viewed
%>
<% current ||= nil %>
<% heading_id = "#{title.parameterize}-head" %>
<section class="panel" aria-labelledby="<%= heading_id %>">
  <div class="panel__head">
    <h2 id="<%= heading_id %>" class="panel__title"><%= title %></h2>
    <span class="panel__note"><%= ammo.size %> rounds</span>
  </div>
  <div class="panel__body panel__body--flush">
    <div class="overflow-x-auto">
      <table class="ammo-table">
        <caption class="sr-only"><%= title %> — sorted by penetration</caption>
        <thead>
          <tr>
            <th scope="col">Round</th>
            <th scope="col">Dmg</th>
            <th scope="col">Pen</th>
            <th scope="col">Class</th>
          </tr>
        </thead>
        <tbody>
          <% ammo.each do |round| %>
            <% pen = round.penetration %>
            <% class_defeated = round.defeats_class %>
            <% is_current = current && round.id == current.id %>
            <tr class="<%= "current" if is_current %>">
              <th scope="row">
                <%= link_to item_path(round), "aria-current": ("true" if is_current) do %>
                  <%= round.short_name.presence || round.full_name %><%= " (viewing)" if is_current %>
                <% end %>
              </th>
              <td><%= round.data["damage"].presence || "—" %></td>
              <% if pen.present? %>
                <td style="color: <%= ammo_tone(round) %>"><%= pen %></td>
                <%# The class is the wiki chart's rule (effectiveness level 4+)
                    where the round has a row; the note names the levels it
                    penetrates rather than repeating six numbers per row. %>
                <td class="muted"
                    aria-label="<%= class_defeated.zero? ? "does not penetrate any armor class" : "penetrates armor classes 1 through #{class_defeated}" %>">
                  <%= class_defeated.zero? ? "—" : class_defeated %>
                </td>
              <% else %>
                <td class="muted">—</td>
                <td class="muted">—</td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if note.present? %>
      <p class="px-4 py-2.5 text-xs text-[var(--text-muted)] border-t border-[var(--border)]"><%= note %></p>
    <% end %>
  </div>
</section>
