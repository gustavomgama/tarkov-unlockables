<div class="space-y-8">
  <div class="flex items-start gap-6">
    <div class="w-48 h-48 bg-[var(--bg-surface)] overflow-hidden flex-shrink-0 border border-[var(--border)]">
      <% largest_img = @item.images.find { |img| img.include?('512') } || @item.images.find { |img| img.include?('8x') } || @item.images.last %>
      <img
        src="<%= largest_img %>"
        alt="<%= @item.full_name %>"
        class="w-full h-full object-contain"
      >
    </div>
    <div class="flex-1">
      <h1 class="text-3xl font-bold mb-2 text-[var(--text-bright)]"><%= @item.full_name %></h1>
      <p class="text-[var(--text-muted)] mb-4"><%= @item.short_name %></p>
      <div class="flex flex-wrap gap-2 mb-4">
        <% @item.categories.each do |cat| %>
          <span class="inline-block px-3 py-1 text-sm bg-[var(--bg-surface)] text-[var(--text)] border border-[var(--border)]">
            <%= cat.humanize %>
          </span>
        <% end %>
      </div>
      <div class="flex gap-3">
        <% @item.links.each do |link| %>
          <%= link_to link, link, class: "text-[var(--accent)] hover:text-[var(--accent-hover)] hover:underline text-sm", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @item.property %>
    <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">Properties</h2>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
        <% if @item.property.armor_class %>
          <div>
            <dt class="text-[var(--text-muted)]">Armor Class</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.property.armor_class %></dd>
          </div>
        <% end %>
        <% if @item.property.caliber %>
          <div>
            <dt class="text-[var(--text-muted)]">Caliber</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.property.caliber %></dd>
          </div>
        <% end %>
        <% if @item.property.damage %>
          <div>
            <dt class="text-[var(--text-muted)]">Damage</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.property.damage %></dd>
          </div>
        <% end %>
        <% if @item.property.penetration_power %>
          <div>
            <dt class="text-[var(--text-muted)]">Penetration</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.property.penetration_power %></dd>
          </div>
        <% end %>
        <% if @item.property.armor_type %>
          <div>
            <dt class="text-[var(--text-muted)]">Armor Type</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.property.armor_type %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>

  <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
    <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">Where to Get</h2>
    <% if @item.obtain_from.any? %>
      <div class="space-y-3">
        <% @item.obtain_from.each do |entry| %>
          <div class="flex items-center gap-3 py-2 border-b border-[var(--border)] last:border-0">
            <span class="px-2 py-1 text-xs font-medium
              <%= case entry.type
                  when :task_reward then 'bg-[var(--badge-task)] text-[var(--text)]'
                  when :hideout then 'bg-[var(--badge-hideout)] text-[var(--text)]'
                  when :barter then 'bg-[var(--badge-barter)] text-[var(--text)]'
                  when :currency then 'bg-[var(--badge-currency)] text-[var(--text)]'
                  end %>">
              <%= entry.type.to_s.humanize %>
            </span>
            <span class="text-sm text-[var(--text)]">
              <% case entry.type %>
              <% when :task_reward %>
                <%= entry.source.task_name %> (Quest Reward)
              <% when :hideout %>
                <%= entry.source.station_name %> Level <%= entry.source.station_level %>
                <% if entry.source.quantity > 1 %>× <%= entry.source.quantity %><% end %>
              <% when :barter %>
                <%= entry.source.trader_name %> LL<%= entry.source.trader_level %>
              <% when :currency %>
                <%= entry.source.trader_name %> LL<%= entry.source.trader_level %> - <%= entry.source.currency %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-[var(--text-muted)]">No obtain methods found.</p>
    <% end %>
  </div>

  <% if @item.how_to_unlock.any? %>
    <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">How to Unlock</h2>
      <div class="space-y-6">
        <% @item.how_to_unlock.each do |path| %>
          <div class="border border-[var(--border)] p-4">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 text-xs font-medium
                <%= case path.unlock_method
                    when :offer_unlock then 'bg-[var(--badge-offer)] text-[var(--text)]'
                    when :barter_unlock then 'bg-[var(--badge-barter)] text-[var(--text)]'
                    when :craft_unlock then 'bg-[var(--badge-craft)] text-[var(--text)]'
                    end %>">
                <%= path.unlock_method.to_s.humanize %>
              </span>
              <span class="font-medium text-[var(--text-bright)]"><%= path.task.full_name %></span>
              <span class="text-sm text-[var(--text-muted)]">
                · <%= path.task.given_by.titleize %> · <%= path.reward_type == "start_rewards" ? "Start reward" : "Finish reward" %>
              </span>
            </div>

            <% unlock_details = @item.unlock_details_for(path) %>
            <% if unlock_details %>
              <div class="text-sm text-[var(--text)] mb-3 pl-2 border-l-2 border-[var(--border)]">
                <%= unlock_details %>
              </div>
            <% end %>

            <% chain = path.task.prerequisite_chain %>
            <% if chain.length > 1 %>
              <div class="mb-2">
                <p class="text-xs text-[var(--text-muted)] mb-2">
                  Complete <%= chain.length - 1 %> prerequisite <%= 'task'.pluralize(chain.length - 1) %> to unlock:
                </p>
                <div class="flex items-center gap-1 flex-wrap">
                  <% chain.reverse.each_with_index do |t, i| %>
                    <% if i > 0 %>
                      <svg class="w-3 h-3 text-[var(--text-muted)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    <% end %>
                    <% if i == chain.length - 1 %>
                      <span class="px-2 py-1 text-xs font-medium bg-[var(--accent)] text-[var(--bg-dark)]">
                        <%= t[:name] %>
                      </span>
                    <% else %>
                      <span class="px-2 py-1 text-xs bg-[var(--bg-elevated)] text-[var(--text)] border border-[var(--border)]">
                        <%= t[:name] %>
                      </span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="text-sm text-[var(--text-muted)]">No prerequisites - available from start</p>
            <% end %>

            <% if path.task.wiki_link.present? %>
              <div class="mt-2">
                <%= link_to path.task.wiki_link, path.task.wiki_link, class: "text-xs text-[var(--accent)] hover:text-[var(--accent-hover)]", target: "_blank", rel: "noopener" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
