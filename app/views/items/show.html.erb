<div class="space-y-8">
  <div class="flex items-start gap-6">
    <div class="w-48 h-48 bg-[var(--bg-surface)] overflow-hidden flex-shrink-0 border border-[var(--border)]">
      <% largest_img = @item.images.find { |img| img.include?('512') } || @item.images.find { |img| img.include?('8x') } || @item.images.last %>
      <img
        src="<%= largest_img %>"
        alt="<%= @item.full_name %>"
        class="w-full h-full object-contain"
      >
    </div>
    <div class="flex-1">
      <h1 class="text-3xl font-bold mb-2 text-[var(--text-bright)]"><%= @item.full_name %></h1>
      <p class="text-[var(--text-muted)] mb-4"><%= @item.short_name %></p>
      <div class="flex flex-wrap gap-2 mb-4">
        <% @item.categories.each do |cat| %>
          <span class="inline-block px-3 py-1 text-sm bg-[var(--bg-surface)] text-[var(--text)] border border-[var(--border)]">
            <%= cat.humanize %>
          </span>
        <% end %>
      </div>
      <div class="flex gap-3">
        <% @item.links.each do |link| %>
          <%= link_to link, link, class: "text-[var(--accent)] hover:text-[var(--accent-hover)] hover:underline text-sm", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @item.data.present? %>
    <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">Details</h2>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
        <% if @item.data["class"].present? %>
          <div>
            <dt class="text-[var(--text-muted)]">Armor Class</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.data["class"] %></dd>
          </div>
        <% end %>
        <% if @item.data["caliber"].present? %>
          <div>
            <dt class="text-[var(--text-muted)]">Caliber</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.data["caliber"] %></dd>
          </div>
        <% end %>
        <% if @item.data["damage"].present? %>
          <div>
            <dt class="text-[var(--text-muted)]">Damage</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.data["damage"] %></dd>
          </div>
        <% end %>
        <% if @item.data["penetration_power"].present? %>
          <div>
            <dt class="text-[var(--text-muted)]">Penetration</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.data["penetration_power"] %></dd>
          </div>
        <% end %>
        <% if @item.data["armor_type"].present? %>
          <div>
            <dt class="text-[var(--text-muted)]">Armor Type</dt>
            <dd class="font-medium text-[var(--text)]"><%= @item.data["armor_type"] %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>

  <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
    <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">Where to Get</h2>
    <% if @item.item_task_rewards.any? || @item.item_hideouts.any? || @item.item_barters.any? || @item.item_currencies.any? %>
      <div class="space-y-3">
        <% @item.item_task_rewards.each do |r| %>
          <div class="flex items-center gap-3 py-2 border-b border-[var(--border)] last:border-0">
            <span class="px-2 py-1 text-xs font-medium bg-[var(--badge-task)] text-[var(--text)]">Task Reward</span>
            <span class="text-sm text-[var(--text)]"><%= r.task_name %></span>
          </div>
        <% end %>
        <% @item.item_hideouts.each do |h| %>
          <div class="flex items-center gap-3 py-2 border-b border-[var(--border)] last:border-0">
            <span class="px-2 py-1 text-xs font-medium bg-[var(--badge-hideout)] text-[var(--text)]">Hideout</span>
            <span class="text-sm text-[var(--text)]"><%= h.station %> Level <%= h.level %></span>
          </div>
        <% end %>
        <% @item.item_barters.each do |b| %>
          <div class="flex items-center gap-3 py-2 border-b border-[var(--border)] last:border-0">
            <span class="px-2 py-1 text-xs font-medium bg-[var(--badge-barter)] text-[var(--text)]">Barter</span>
            <span class="text-sm text-[var(--text)]"><%= b.trader %> LL<%= b.trader_level %> - <%= b.currency %> <%= b.cost %></span>
          </div>
        <% end %>
        <% @item.item_currencies.each do |c| %>
          <div class="flex items-center gap-3 py-2 border-b border-[var(--border)] last:border-0">
            <span class="px-2 py-1 text-xs font-medium bg-[var(--badge-currency)] text-[var(--text)]">Trader</span>
            <span class="text-sm text-[var(--text)]"><%= c.trader %> LL<%= c.min_trader_level %> - <%= c.currency %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-[var(--text-muted)]">No obtain methods found.</p>
    <% end %>
  </div>

  <% unlocks = OfferUnlock.where(item_id: @item.id) + BarterUnlock.where(item_id: @item.id) + CraftUnlock.where(item_id: @item.id) %>
  <% if unlocks.any? %>
    <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
      <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">How to Unlock</h2>
      <div class="space-y-6">
        <% unlocks.each do |unlock| %>
          <div class="border border-[var(--border)] p-4">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 text-xs font-medium bg-[var(--badge-offer)] text-[var(--text)]"><%= unlock.class.name.demodulize.titleize %></span>
              <span class="font-medium text-[var(--text-bright)]"><%= unlock.reward&.task&.full_name %></span>
              <span class="text-sm text-[var(--text-muted)]">· <%= unlock.reward&.task&.given_by&.titleize %></span>
            </div>

            <% chain = unlock.reward&.task&.prerequisite_chain %>
            <% if chain && chain.length > 1 %>
              <div class="mb-2">
                <p class="text-xs text-[var(--text-muted)] mb-2">
                  Complete <%= chain.length - 1 %> prerequisite <%= 'task'.pluralize(chain.length - 1) %> to unlock:
                </p>
                <div class="flex items-center gap-1 flex-wrap">
                  <% chain.reverse.each_with_index do |t, i| %>
                    <% if i > 0 %>
                      <svg class="w-3 h-3 text-[var(--text-muted)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    <% end %>
                    <% if i == chain.length - 1 %>
                      <span class="px-2 py-1 text-xs font-medium bg-[var(--accent)] text-[var(--bg-dark)]">
                        <%= t[:name] %>
                      </span>
                    <% else %>
                      <span class="px-2 py-1 text-xs bg-[var(--bg-elevated)] text-[var(--text)] border border-[var(--border)]">
                        <%= t[:name] %>
                      </span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% elsif chain %>
              <p class="text-sm text-[var(--text-muted)]">No prerequisites - available from start</p>
            <% end %>

            <% if unlock.reward&.task&.wiki_link.present? %>
              <div class="mt-2">
                <%= link_to unlock.reward.task.wiki_link, unlock.reward.task.wiki_link, class: "text-xs text-[var(--accent)] hover:text-[var(--accent-hover)]", target: "_blank", rel: "noopener" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>