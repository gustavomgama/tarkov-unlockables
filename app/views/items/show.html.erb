<% content_for :title, @item.full_name %>
<% content_for :description, "#{@item.full_name} — Escape from Tarkov stats, acquisition routes and unlock chain." %>

<% kind = @item.class.name.demodulize.titleize %>
<% packs = @item.ammo_packs.to_a %>
<% caliber = item_caliber(@item) %>
<% accepted = compatible_ammo(@item) %>
<%# A weapon or magazine declares the rounds it takes; an ammo item does
    not, so it gets the rest of its caliber. Never both — same table. %>
<% siblings = accepted.empty? && @item.data["caliber"].present? ? @item.caliber_ammo.to_a : [] %>
<% used_in_barters = @item.item_barter_requirements.to_a %>
<% used_in_crafts = @item.item_hideout_requirements.to_a %>
<% used_in_objectives = @item.task_objective_items.to_a %>
<% variants = Array(@item.data["weapon_variants"]).select { |v| v.is_a?(Hash) && v["name"].present? } %>
<% contains = Array(@item.data["containsItems"]) %>
<% has_main = siblings.size > 1 || accepted.any? || packs.any? || used_in_barters.any? ||
              used_in_crafts.any? || used_in_objectives.any? || variants.any? ||
              @item_slots.any? || @item_fits.any? || @item_key_tasks.any? || contains.any? %>

<div class="space-y-4 sm:space-y-6">
  <nav class="crumbs no-print" aria-label="Breadcrumb">
    <%= link_to "Items", items_path %>
    <span aria-hidden="true">/</span>
    <span class="text-[var(--text)]"><%= kind %></span>
  </nav>

  <%# Hero: who this item is and the numbers that decide it. %>
  <section class="panel">
    <div class="panel__body">
      <div class="flex gap-4 sm:gap-6">
        <div class="w-20 sm:w-28 lg:w-32 shrink-0 aspect-square bg-[var(--bg-panel)] border border-[var(--border)]">
          <%= render "items/image", item: @item, size: :hero %>
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div class="min-w-0">
              <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-[var(--text-bright)] leading-tight break-words"><%= @item.full_name %></h1>

              <% if @item.short_name.present? && !@item.full_name.to_s.downcase.include?(@item.short_name.to_s.downcase) %>
                <p class="mt-1 font-data text-sm text-[var(--text-muted)]"><%= @item.short_name %></p>
              <% end %>

              <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
                <% category_chips(@item).each do |label| %>
                  <span class="chip chip--strong"><%= label %></span>
                <% end %>
                <% @item.external_links.each do |url| %>
                  <%= link_to external_link_label(url), html_escape(url), class: "chip chip--link", target: "_blank", rel: "noopener" %>
                <% end %>
              </div>
            </div>

            <div class="shrink-0 no-print">
              <%= render "favorites/favorite", item: @item %>
            </div>
          </div>
        </div>
      </div>

      <%# The stats partial decides what it has to say; the frame is drawn
          only when it produced something, so a bare item gets no empty box. %>
      <% stats = render(@item.stats_partial, item: @item) %>
      <% if rendered_content?(stats) %>
        <div class="mt-4 sm:mt-5">
          <div class="readout"><%= stats %></div>
        </div>
      <% end %>
    </div>
  </section>

  <div class="grid gap-4 sm:gap-5 <%= "lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start" if has_main %>">
    <% if has_main %>
      <div class="min-w-0 space-y-4 sm:space-y-5">
        <% if siblings.size > 1 %>
          <%= render "items/ammo_table",
                ammo: siblings,
                current: @item,
                title: "Rounds in #{caliber}",
                note: "Sorted by penetration. Class is the heaviest armor this round reliably defeats." %>
        <% end %>

        <% if accepted.any? %>
          <%= render "items/ammo_table",
                ammo: accepted,
                current: nil,
                title: "Ammunition accepted",
                note: "Every round this can chamber, hardest-hitting first." %>
        <% end %>

        <% if contains.any? %>
          <section class="panel" aria-labelledby="contains-head">
            <div class="panel__head">
              <h2 id="contains-head" class="panel__title">Contains</h2>
              <span class="panel__note"><%= contains.size %> <%= "entry".pluralize(contains.size) %></span>
            </div>
            <%= render "items/contains", contains: contains,
                  contained: bsg_items(contains.map { |entry| entry["item"] }).index_by(&:bsg_id) %>
          </section>
        <% end %>

        <% if variants.any? %>
          <section class="panel" aria-labelledby="variants-head">
            <div class="panel__head">
              <h2 id="variants-head" class="panel__title">Build variants</h2>
              <span class="panel__note"><%= variants.size %> <%= "build".pluralize(variants.size) %></span>
            </div>
            <%= render "items/variants", item: @item %>
          </section>
        <% end %>

        <% if @item_slots.any? %>
          <section class="panel" aria-labelledby="slots-head">
            <div class="panel__head">
              <h2 id="slots-head" class="panel__title">Slots</h2>
              <span class="panel__note">what fits</span>
            </div>
            <div class="panel__body panel__body--flush">
              <% @item_slots.each do |slot| %>
                <div class="srcrow">
                  <span class="srcbadge" style="--tone: var(--badge-currency)">
                    <%= slot[:name].presence || "Slot" %><%= " *" if slot[:required] %>
                  </span>
                  <div class="srcrow__body">
                    <p class="srcrow__title">
                      <%= safe_join(slot[:allowed].first(6).map { |id, name| link_to name, item_path(id) }, ", ") %>
                    </p>
                    <% if slot[:allowed].size > 6 %>
                      <details class="disclosure">
                        <summary class="srcrow__meta">and <%= slot[:allowed].size - 6 %> more</summary>
                        <p class="srcrow__title mt-1">
                          <%= safe_join(slot[:allowed].drop(6).map { |id, name| link_to name, item_path(id) }, ", ") %>
                        </p>
                      </details>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if used_in_barters.any? || used_in_crafts.any? || used_in_objectives.any? || @item_fits.any? || @item_key_tasks.any? %>
          <section class="panel" aria-labelledby="used-in-head">
            <div class="panel__head">
              <h2 id="used-in-head" class="panel__title">Used in</h2>
              <span class="panel__note">what this item is worth</span>
            </div>
            <%= render "items/used_in", item: @item, barters: used_in_barters,
                  crafts: used_in_crafts, objectives: used_in_objectives,
                  fits: @item_fits, key_tasks: @item_key_tasks %>
          </section>
        <% end %>

        <% if packs.any? %>
          <section class="panel" aria-labelledby="part-of-head">
            <div class="panel__head">
              <h2 id="part-of-head" class="panel__title">Packs &amp; presets</h2>
              <span class="panel__note"><%= packs.size %> <%= "entry".pluralize(packs.size) %></span>
            </div>
            <%= render "items/part_of", item: @item, packs: packs %>
          </section>
        <% end %>
      </div>
    <% end %>

    <aside class="min-w-0 space-y-4 sm:space-y-5 <%= "lg:sticky lg:top-20" if has_main %>">
      <section class="panel" aria-labelledby="where-head">
        <div class="panel__head">
          <h2 id="where-head" class="panel__title">Where to get</h2>
        </div>
        <%= render "items/obtain", item: @item %>
      </section>

      <section class="panel" aria-labelledby="unlock-head">
        <div class="panel__head">
          <h2 id="unlock-head" class="panel__title">How to unlock</h2>
        </div>
        <%= render "items/unlock_paths", item: @item %>
      </section>
    </aside>
  </div>
</div>
