<%# Site-wide feedback, two channels by design:
       - the Tally form, embedded inline, for anyone: private, no account
       - the utterances thread, for public discussion: needs a GitHub login
     utterances renders a public GitHub issue thread, so it needs the app
     installed on the repo and a pinned issue
     (https://github.com/apps/utterances). Tally's embed.js sizes the iframe
     from the form, so no fixed height here — the height attribute below is
     only the pre-load placeholder. %>
<section class="mt-6" aria-labelledby="feedback-heading">
  <details class="disclosure">
    <summary class="inline-flex items-center gap-2 min-h-[44px] px-3 border border-[var(--border)] bg-[var(--bg-surface)] hover:border-[var(--accent)]">
      <span id="feedback-heading" class="text-sm font-bold text-[var(--text)]">Suggestions &amp; feedback</span>
      <span class="text-xs text-[var(--text-muted)]">spotted a wrong price or a missing quest?</span>
    </summary>

  <p class="text-xs text-[var(--text-muted)] mb-3">
    Spotted a wrong price, a missing task, or want a feature? Send it over —
    no account needed, and messages go straight to the maintainer. Prefer to
    discuss it in the open? Use the thread below.
  </p>

  <div class="max-w-3xl mb-6">
    <iframe
      data-tally-src="https://tally.so/embed/Pd77Md?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
      loading="lazy"
      width="100%"
      height="300"
      style="border:0"
      title="Private feedback form"
    ></iframe>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </div>

  <h3 class="text-sm font-bold uppercase tracking-wide text-[var(--text-muted)] mb-1">
    Public thread
  </h3>

  <p class="text-xs text-[var(--text-muted)] mb-3">
    Every message is public and lands in
    <%= link_to "the issue tracker", "https://github.com/gustavomgama/tarkov-unlockables/issues/9",
                class: "text-[var(--accent)] hover:text-[var(--accent-hover)]",
                target: "_blank", rel: "noopener" %>.
    A GitHub account is required to post.
  </p>

      <div class="mb-6">
        <iframe
          data-tally-src="https://tally.so/embed/Pd77Md?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="300"
          style="border:0"
          title="Private feedback form"
        ></iframe>
        <script async src="https://tally.so/widgets/embed.js"></script>
      </div>

      <h3 class="text-xs font-bold uppercase tracking-wide text-[var(--text-muted)] mb-1">
        Public thread
      </h3>

      <p class="text-xs text-[var(--text-muted)] mb-3">
        Every message is public and lands in
        <%= link_to "the issue tracker", "https://github.com/gustavomgama/tarkov-unlockables/issues/9",
                    target: "_blank", rel: "noopener" %>.
        A GitHub account is required to post.
      </p>

      <div class="max-w-3xl max-h-[600px] overflow-y-auto">
        <script src="https://utteranc.es/client.js"
                repo="gustavomgama/tarkov-unlockables"
                issue-number="9"
                theme="github-dark"
                crossorigin="anonymous"
                async></script>
      </div>
    </div>
  </details>
</section>
