<%# Site-wide feedback box. The script is parked in a <template> so nothing
    third-party loads until the visitor opens the section; utterances is driven
    by the Stimulus controller when the <details> is toggled. %>
<details class="group" data-controller="feedback" data-action="toggle->feedback#load">
  <summary class="inline-block cursor-pointer text-sm text-[var(--text-muted)] hover:text-[var(--accent)] py-2">
    Suggestions &amp; feedback
  </summary>

  <div class="mt-3 max-w-3xl">
    <p class="text-xs text-[var(--text-muted)] mb-3">
      Every message is public and lands in
      <%= link_to "the issue tracker", "https://github.com/gustavomgama/tarkov-unlockables/issues/9",
                  class: "text-[var(--accent)] hover:text-[var(--accent-hover)]",
                  target: "_blank", rel: "noopener" %>.
      A GitHub account is required to post.
    </p>

    <div data-feedback-target="container"></div>
  </div>

  <template data-feedback-target="template">
    <script src="https://utteranc.es/client.js"
            repo="gustavomgama/tarkov-unlockables"
            issue-number="9"
            theme="github-dark"
            crossorigin="anonymous"
            async></script>
  </template>
</details>
