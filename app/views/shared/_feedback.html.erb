<%# Site-wide feedback box. utterances renders a public GitHub issue thread, so
    this needs the utterances app installed on the repo and a pinned issue
    (https://github.com/apps/utterances). %>
<section class="mt-6" aria-labelledby="feedback-heading">
  <h2 id="feedback-heading" class="text-sm font-bold uppercase tracking-wide text-[var(--text-muted)] mb-1">
    Suggestions &amp; feedback
  </h2>

  <p class="text-xs text-[var(--text-muted)] mb-3">
    Every message is public and lands in
    <%= link_to "the issue tracker", "https://github.com/gustavomgama/tarkov-unlockables/issues/9",
                class: "text-[var(--accent)] hover:text-[var(--accent-hover)]",
                target: "_blank", rel: "noopener" %>.
    A GitHub account is required to post.
  </p>

  <div class="max-w-3xl">
    <script src="https://utteranc.es/client.js"
            repo="gustavomgama/tarkov-unlockables"
            issue-number="9"
            theme="github-dark"
            crossorigin="anonymous"
            async></script>
  </div>
</section>
