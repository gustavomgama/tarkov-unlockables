<% content_for :title, @task.full_name %>
<% content_for :description, "#{@task.full_name} — Escape from Tarkov quest: requirements, rewards and unlock chain." %>
<% chain = @task.prerequisite_chain([], task_map) %>
<% prerequisites = chain.length - 1 %>
<% requirements = @task.requirements.select { |r|
     r.player_level.to_i.positive? || r.previous_tasks.any? || trader_requirements(r).any?
   } %>
<% reward_total = reward_count(@task) %>

<div class="space-y-4 sm:space-y-6">
  <nav class="crumbs no-print" aria-label="Breadcrumb">
    <%= link_to "Tasks", tasks_path %>
    <span aria-hidden="true">/</span>
    <span class="text-[var(--text)]"><%= @task.given_by.presence&.titleize || "Unassigned" %></span>
  </nav>

  <%# Hero: which quest this is and what it takes to reach it. %>
  <section class="panel">
    <div class="panel__body">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div class="min-w-0">
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-[var(--text-bright)] leading-tight break-words"><%= @task.full_name %></h1>
          <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-[var(--text-muted)]">
            <span class="inline-flex items-center gap-2">
              <span class="trader-dot" style="background: var(--trader-<%= @task.given_by.to_s.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
              <% if @task.given_by.present? %>
                <%= link_to @task.given_by.titleize, trader_path(@task.given_by.parameterize) %>
              <% else %>
                Unassigned
              <% end %>
            </span>
            <% if @task.kappa_required %>
              <span class="chip" style="--tone: var(--danger); background: var(--danger); color: var(--text-bright)">Kappa required</span>
            <% end %>
            <% if @task.lightkeeper_required %>
              <span class="chip" style="background: var(--trader-lightkeeper); color: var(--text-bright)">Lightkeeper required</span>
            <% end %>
          </p>

          <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
            <% if @task.given_by.present? %>
              <%= link_to "#{@task.given_by.titleize} quests", tasks_path(trader: @task.given_by), class: "chip chip--link" %>
            <% end %>
            <% if @task.map_name.present? %>
              <%= link_to "#{@task.map_name} quests", tasks_path(map: @task.map_name), class: "chip chip--link" %>
            <% end %>
            <% if @task.faction.present? && @task.faction != "Any" %>
              <span class="chip"><%= @task.faction %> only</span>
            <% end %>
            <% if @task.wiki_link.present? %>
              <a href="<%= @task.wiki_link %>" target="_blank" rel="noopener" class="chip chip--link">Wiki walkthrough</a>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-4 sm:mt-5">
        <div class="readout">
          <div class="stats">
            <div class="stat stat--xl">
              <span class="stat__key">Prerequisites</span>
              <span class="stat__val"><%= prerequisites %></span>
              <span class="stat__note"><%= prerequisites.zero? ? "no earlier quest" : "quests to clear first" %></span>
            </div>
            <% if @task.leads_tos.any? %>
              <div class="stat">
                <span class="stat__key">Leads to</span>
                <span class="stat__val"><%= @task.leads_tos.size %></span>
                <span class="stat__note"><%= "follow-up quest".pluralize(@task.leads_tos.size) %></span>
              </div>
            <% end %>
            <% if @task.experience.to_i.positive? %>
              <div class="stat">
                <span class="stat__key">XP</span>
                <span class="stat__val"><%= number_with_delimiter(@task.experience) %></span>
                <span class="stat__note">experience</span>
              </div>
            <% end %>
            <% if reward_total.positive? %>
              <div class="stat">
                <span class="stat__key">Rewards</span>
                <span class="stat__val"><%= reward_total %></span>
                <span class="stat__note"><%= "item or unlock".pluralize(reward_total) %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="grid gap-4 sm:gap-5 lg:grid-cols-2 lg:items-start">
    <%# Unlock path: the reason to read this page. %>
    <% if chain.length > 1 %>
      <section class="panel lg:col-span-2" aria-labelledby="path-head">
        <div class="panel__head">
          <h2 id="path-head" class="panel__title">Unlock path</h2>
          <span class="panel__note"><%= prerequisites %> prerequisite <%= "quest".pluralize(prerequisites) %> before this one</span>
        </div>
        <div class="panel__body">
          <%= render "shared/raid_timeline", chain: chain, current_name: @task.name %>
        </div>
      </section>
    <% end %>

    <% if requirements.any? %>
      <section class="panel" aria-labelledby="requirements-head">
        <div class="panel__head">
          <h2 id="requirements-head" class="panel__title">Requirements</h2>
        </div>
        <dl class="specs">
          <% requirements.each do |req| %>
            <% if req.player_level.to_i.positive? %>
              <div class="spec">
                <dt class="spec__key">Player level</dt>
                <dd class="spec__val"><%= req.player_level %></dd>
              </div>
            <% end %>
            <% trader_requirements(req).each do |entry| %>
              <div class="spec">
                <dt class="spec__key">Trader</dt>
                <dd class="spec__val">
                  <% if entry["trader_name"].present? %>
                    <%= link_to "#{entry['trader_name'].to_s.titleize} LL#{entry['trader_level']}", trader_path(entry["trader_name"].to_s.parameterize) %>
                  <% else %>
                    <%= trader_requirement_label(entry) %>
                  <% end %>
                </dd>
              </div>
            <% end %>
            <% if req.previous_tasks.any? %>
              <div class="spec">
                <dt class="spec__key">Previous tasks</dt>
                <dd class="spec__val flex flex-wrap justify-end gap-1">
                  <% req.previous_tasks.each do |pt| %>
                    <% task = pt.task %>
                    <% if task %>
                      <%= link_to task_display_name(pt.task_name), task_path(task), class: "chip chip--link" %>
                    <% else %>
                      <span class="chip"><%= task_display_name(pt.task_name) %></span>
                    <% end %>
                  <% end %>
                </dd>
              </div>
            <% end %>
          <% end %>
        </dl>
      </section>
    <% end %>

    <% if @task.needed_keys.any? %>
      <section class="panel lg:col-span-2" aria-labelledby="keys-head">
        <div class="panel__head">
          <h2 id="keys-head" class="panel__title">Keys needed</h2>
          <span class="panel__note">to reach the objective</span>
        </div>
        <dl class="specs">
          <% @task.needed_keys.group_by { |key| key["map_name"] }.each do |map_name, keys| %>
            <div class="spec">
              <dt class="spec__key"><%= map_name.presence || "Any map" %></dt>
              <dd class="spec__val flex flex-wrap justify-end gap-1">
                <% keys.each do |key| %>
                  <% if key["item_id"] %>
                    <%= link_to key["item_name"], item_path(key["item_id"]), class: "chip chip--link" %>
                  <% else %>
                    <span class="chip"><%= key["item_name"] %></span>
                  <% end %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>


    <section class="panel <%= "lg:col-span-2" unless requirements.any? %>" aria-labelledby="rewards-head">
      <div class="panel__head">
        <h2 id="rewards-head" class="panel__title">Rewards</h2>
      </div>
      <% if reward_total.zero? %>
        <div class="panel__body">
          <p class="text-sm text-[var(--text-muted)]">No rewards listed.</p>
        </div>
      <% else %>
        <% @task.rewards.each do |reward| %>
          <% groups = reward_groups(reward) %>
          <% data_groups = reward_data_groups(reward) %>
          <% next if groups.empty? && data_groups.empty? %>
          <div class="panel__body panel__body--flush">
            <p class="px-4 pt-3 pb-1 text-[0.625rem] uppercase tracking-widest text-[var(--text-muted)]">
              <%= reward.reward_type == "start_rewards" ? "On accepting" : "On completion" %>
            </p>
            <% groups.each do |label, rows, badge| %>
              <% rows.each do |row| %>
                <div class="srcrow">
                  <span class="srcbadge" style="--tone: var(--<%= badge %>)"><%= reward_label(label, row) %></span>
                  <div class="srcrow__body">
                    <p class="srcrow__title">
                      <% if row.item %>
                        <%= link_to row.item_name, item_path(row.item) %>
                      <% else %>
                        <%= row.item_name %>
                      <% end %>
                      <% if row.respond_to?(:count) && row.count.to_i > 1 %>
                        <span class="font-data text-[var(--text-muted)]">×<%= row.count %></span>
                      <% end %>
                    </p>
                    <p class="srcrow__meta">
                      <% if row.respond_to?(:trader_name) && row.trader_name.present? %>
                        <span class="font-data"><%= "#{row.trader_name} LL#{row.trader_level}" %></span>
                      <% elsif row.respond_to?(:hideout_station) && row.hideout_station.present? %>
                        <span class="font-data"><%= "#{row.hideout_station} Lv.#{row.station_level}" %></span>
                      <% else %>
                        granted for completing the quest
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>
            <% end %>
            <% data_groups.each do |label, badge, lines| %>
              <div class="srcrow">
                <span class="srcbadge" style="--tone: var(--<%= badge %>)"><%= label %></span>
                <div class="srcrow__body">
                  <p class="srcrow__title"><%= lines.to_sentence %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </section>

    <% gated_currencies = @task.gated_currencies %>
    <% if gated_currencies.any? %>
      <section class="panel lg:col-span-2" aria-labelledby="gated-head">
        <div class="panel__head">
          <h2 id="gated-head" class="panel__title">Unlocks trader offers</h2>
          <span class="panel__note"><%= gated_currencies.size %> buyable after this quest</span>
        </div>
        <div class="panel__body panel__body--flush">
          <% gated_currencies.each do |currency| %>
            <div class="srcrow">
              <span class="srcbadge" style="--tone: var(--badge-currency)">Trader</span>
              <div class="srcrow__body">
                <p class="srcrow__title">
                  <%= link_to currency.item.full_name, item_path(currency.item) %>
                </p>
                <p class="srcrow__meta">
                  <span class="font-data"><%= "#{currency.trader.to_s.titleize} LL#{currency.min_trader_level}" %></span>
                  <% if currency.price.present? %>
                    · <span class="font-data"><%= number_with_delimiter(currency.price) %> <%= currency.currency %></span>
                  <% elsif currency.currency.present? %>
                    · <span class="font-data"><%= currency.currency %></span>
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @task.leads_tos.any? %>
      <section class="panel lg:col-span-2" aria-labelledby="leads-head">
        <div class="panel__head">
          <h2 id="leads-head" class="panel__title">Leads to</h2>
          <span class="panel__note">unlocked after this quest</span>
        </div>
        <div class="panel__body">
          <div class="flex flex-wrap gap-1.5">
            <% @task.leads_tos.each do |lead| %>
              <% if lead.follow_up_task %>
                <%= link_to lead.follow_up_task.full_name, task_path(lead.follow_up_task), class: "chip chip--link" %>
              <% else %>
                <span class="chip"><%= task_display_name(lead.follow_up_task_name) %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
