<% content_for :title, @task.full_name %>
<% chain = @task.prerequisite_chain([], task_map) %>
<% prerequisites = chain.length - 1 %>
<% requirements = @task.requirements.select { |r| r.player_level.to_i.positive? || r.previous_tasks.any? } %>
<% reward_count = @task.rewards.sum { |r| r.loose_items.size + r.offer_unlocks.size + r.barter_unlocks.size + r.craft_unlocks.size } %>

<div class="space-y-4 sm:space-y-6">
  <nav class="crumbs" aria-label="Breadcrumb">
    <%= link_to "Tasks", tasks_path %>
    <span aria-hidden="true">/</span>
    <span class="text-[var(--text)]"><%= @task.given_by.presence&.titleize || "Unassigned" %></span>
  </nav>

  <%# Hero: which quest this is and what it takes to reach it. %>
  <section class="panel">
    <div class="panel__body">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div class="min-w-0">
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-[var(--text-bright)] leading-tight break-words"><%= @task.full_name %></h1>
          <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-[var(--text-muted)]">
            <span class="inline-flex items-center gap-2">
              <span class="trader-dot" style="background: var(--trader-<%= @task.given_by.to_s.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
              <%= @task.given_by.to_s.titleize %>
            </span>
            <% if @task.kappa_required %>
              <span class="chip" style="--tone: var(--danger); background: var(--danger); color: var(--text-bright)">Kappa required</span>
            <% end %>
          </p>
        </div>
      </div>

      <div class="mt-4 sm:mt-5">
        <div class="readout">
          <div class="stats">
            <div class="stat stat--xl">
              <span class="stat__key">Prerequisites</span>
              <span class="stat__val"><%= prerequisites %></span>
              <span class="stat__note"><%= prerequisites.zero? ? "no earlier quest" : "quests to clear first" %></span>
            </div>
            <% if @task.leads_tos.any? %>
              <div class="stat">
                <span class="stat__key">Leads to</span>
                <span class="stat__val"><%= @task.leads_tos.size %></span>
                <span class="stat__note"><%= "follow-up quest".pluralize(@task.leads_tos.size) %></span>
              </div>
            <% end %>
            <% if reward_count.positive? %>
              <div class="stat">
                <span class="stat__key">Rewards</span>
                <span class="stat__val"><%= reward_count %></span>
                <span class="stat__note"><%= "item or unlock".pluralize(reward_count) %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="grid gap-4 sm:gap-5 lg:grid-cols-2 lg:items-start">
    <%# Unlock path: the reason to read this page. %>
    <% if chain.length > 1 %>
      <section class="panel lg:col-span-2" aria-labelledby="path-head">
        <div class="panel__head">
          <h2 id="path-head" class="panel__title">Unlock path</h2>
          <span class="panel__note"><%= prerequisites %> prerequisite <%= "quest".pluralize(prerequisites) %> before this one</span>
        </div>
        <div class="panel__body">
          <%= render "shared/raid_timeline", chain: chain, current_name: @task.name %>
        </div>
      </section>
    <% end %>

    <% if requirements.any? %>
      <section class="panel" aria-labelledby="requirements-head">
        <div class="panel__head">
          <h2 id="requirements-head" class="panel__title">Requirements</h2>
        </div>
        <dl class="specs">
          <% requirements.each do |req| %>
            <% if req.player_level.to_i.positive? %>
              <div class="spec">
                <dt class="spec__key">Player level</dt>
                <dd class="spec__val"><%= req.player_level %></dd>
              </div>
            <% end %>
            <% if req.previous_tasks.any? %>
              <div class="spec">
                <dt class="spec__key">Previous tasks</dt>
                <dd class="spec__val flex flex-wrap justify-end gap-1">
                  <% req.previous_tasks.each do |pt| %>
                    <% task = pt.task %>
                    <% if task %>
                      <%= link_to task_display_name(pt.task_name), task_path(task), class: "chip chip--link" %>
                    <% else %>
                      <span class="chip"><%= task_display_name(pt.task_name) %></span>
                    <% end %>
                  <% end %>
                </dd>
              </div>
            <% end %>
          <% end %>
        </dl>
      </section>
    <% end %>

    <section class="panel <%= "lg:col-span-2" unless requirements.any? %>" aria-labelledby="rewards-head">
      <div class="panel__head">
        <h2 id="rewards-head" class="panel__title">Rewards</h2>
      </div>
      <% if reward_count.zero? %>
        <div class="panel__body">
          <p class="text-sm text-[var(--text-muted)]">No rewards listed.</p>
        </div>
      <% else %>
        <% @task.rewards.each do |reward| %>
          <% groups = reward_groups(reward) %>
          <% next if groups.empty? %>
          <div class="panel__body panel__body--flush">
            <p class="px-4 pt-3 pb-1 text-[0.625rem] uppercase tracking-widest text-[var(--text-muted)]">
              <%= reward.reward_type == "start_rewards" ? "On accepting" : "On completion" %>
            </p>
            <% groups.each do |label, rows, badge| %>
              <% rows.each do |row| %>
                <div class="srcrow">
                  <span class="srcbadge" style="--tone: var(--<%= badge %>)"><%= reward_label(label, row) %></span>
                  <div class="srcrow__body">
                    <p class="srcrow__title">
                      <% if row.item %>
                        <%= link_to row.item_name, item_path(row.item) %>
                      <% else %>
                        <%= row.item_name %>
                      <% end %>
                      <% if row.respond_to?(:count) && row.count.to_i > 1 %>
                        <span class="font-data text-[var(--text-muted)]">×<%= row.count %></span>
                      <% end %>
                    </p>
                    <p class="srcrow__meta">
                      <% if row.respond_to?(:trader_name) && row.trader_name.present? %>
                        <span class="font-data"><%= "#{row.trader_name} LL#{row.trader_level}" %></span>
                      <% elsif row.respond_to?(:hideout_station) && row.hideout_station.present? %>
                        <span class="font-data"><%= "#{row.hideout_station} Lv.#{row.station_level}" %></span>
                      <% else %>
                        granted for completing the quest
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </section>

    <% if @task.leads_tos.any? %>
      <section class="panel lg:col-span-2" aria-labelledby="leads-head">
        <div class="panel__head">
          <h2 id="leads-head" class="panel__title">Leads to</h2>
          <span class="panel__note">unlocked after this quest</span>
        </div>
        <div class="panel__body">
          <div class="flex flex-wrap gap-1.5">
            <% @task.leads_tos.each do |lead| %>
              <% if lead.follow_up_task %>
                <%= link_to lead.follow_up_task.full_name, task_path(lead.follow_up_task), class: "chip chip--link" %>
              <% else %>
                <span class="chip"><%= task_display_name(lead.follow_up_task_name) %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
