<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-[var(--text-bright)]">Task Chains</h1>
    <span class="text-sm text-[var(--text-muted)]">Visualizing task dependencies</span>
  </div>

  <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
    <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">Task Dependency Graph</h2>
    <p class="text-sm text-[var(--text-muted)] mb-6">
      Shows task prerequisites and follow-up chains. Tasks are connected to their prerequisite tasks.
    </p>

    <div class="overflow-x-auto">
      <svg class="min-w-full" viewBox="0 0 800 400" id="task-graph">
        <% task_ids = @tasks.pluck(:id) %>
        <% task_map = @tasks.index_by(&:id) %>

        <% @tasks.each do |task| %>
          <% req = task.requirements.first %>
          <% next unless req&.previous_tasks&.any? %>

          <% req.previous_tasks.each do |pt| %>
            <% prev_task = task_map.values.find { |t| t.name == pt.task_name } %>
            <% next unless prev_task && task_ids.include?(prev_task.id) %>
            <% x1 = 50 + (task_ids.index(prev_task.id) % 10) * 80 %>
            <% y1 = 50 + (task_ids.index(prev_task.id) / 10) * 50 %>
            <% x2 = 50 + (task_ids.index(task.id) % 10) * 80 %>
            <% y2 = 50 + (task_ids.index(task.id) / 10) * 50 %>
            <line x1="<%= x1 %>" y1="<%= y1 %>" x2="<%= x2 %>" y2="<%= y2 %>"
                  stroke="var(--border)" stroke-width="2" opacity="0.5"/>
          <% end %>
        <% end %>

        <% @tasks.each_with_index do |task, idx| %>
          <% x = 50 + (idx % 10) * 80 %>
          <% y = 50 + (idx / 10) * 50 %>
          <% has_prereqs = task.requirements.any? && task.requirements.first.previous_tasks.any? %>

          <g transform="translate(<%= x %>, <%= y %>)">
            <rect x="-30" y="-15" width="60" height="30"
                  class="<%= has_prereqs ? 'fill-[var(--badge-task)]' : 'fill-[var(--bg-elevated)]' %>"
                  stroke="var(--border)" stroke-width="2"/>
            <text x="0" y="5" text-anchor="middle"
                  class="text-xs fill-current text-[var(--text)]">
              <%= task.name.length > 8 ? task.name[0..7] + '...' : task.name %>
            </text>
            <% if has_prereqs %>
              <circle cx="-25" cy="-10" r="4" class="fill-[var(--accent)]"/>
            <% end %>
            <% if task.leads_tos_count > 0 %>
              <circle cx="25" cy="10" r="4" class="fill-[var(--success)]"/>
            <% end %>
          </g>
        <% end %>
      </svg>
    </div>

    <div class="flex items-center gap-6 mt-4 text-sm">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded bg-[var(--badge-task)]"></span>
        <span class="text-[var(--text-muted)]">Has prerequisites</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded bg-[var(--success)]"></span>
        <span class="text-[var(--text-muted)]">Leads to other tasks</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded bg-[var(--bg-elevated)]"></span>
        <span class="text-[var(--text-muted)]">No dependencies</span>
      </div>
    </div>
  </div>

  <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
    <h2 class="text-lg font-semibold mb-4 text-[var(--text-bright)]">Task List</h2>
    <div class="space-y-2 max-h-96 overflow-y-auto">
      <% @tasks.each do |task| %>
        <% req = task.requirements.first %>
        <% prereq_count = req&.previous_tasks_count || 0 %>
        <%= link_to task_path(task), class: "block p-3 hover:bg-[var(--bg-elevated)]" do %>
          <div class="flex items-center gap-2">
            <span class="font-medium text-[var(--text-bright)]"><%= task.full_name %></span>
            <span class="text-sm text-[var(--text-muted)]">by <%= task.given_by.titleize %></span>
            <% if prereq_count > 0 %>
              <span class="text-xs px-2 py-0.5 bg-[var(--badge-task)] text-[var(--text)]">
                <%= prereq_count %> prereqs
              </span>
            <% end %>
            <% if task.leads_tos_count > 0 %>
              <span class="text-xs px-2 py-0.5 bg-[var(--badge-craft)] text-[var(--text)]">
                <%= task.leads_tos_count %> follows
              </span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
