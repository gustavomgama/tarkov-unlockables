<div class="space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-2">
    <h1 class="text-2xl font-bold text-[var(--text-bright)]">Task Chains</h1>
    <span class="text-sm text-[var(--text-muted)]">Unlock paths by trader</span>
  </div>

  <p class="text-sm text-[var(--text-muted)]">
    Each trader's task progression, from tasks with no prerequisites to their deepest chains.
  </p>

  <% tasks_by_trader = @tasks.group_by(&:given_by).sort_by { |trader, _| trader.to_s } %>
  <% tasks_by_trader.each do |trader, trader_tasks| %>
    <% # deepest chain per trader: task with the longest prerequisite chain %>
    <% deepest = trader_tasks.max_by { |t| t.prerequisite_chain.length } %>
    <% next unless deepest %>
    <% chain = deepest.prerequisite_chain %>
    <% next unless chain.length > 1 %>

    <div class="bg-[var(--bg-surface)] border border-[var(--border)] p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="trader-dot" style="background: var(--trader-<%= trader.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
        <h2 class="text-lg font-bold text-[var(--text-bright)]"><%= trader.titleize %></h2>
        <span class="font-data text-xs text-[var(--text-muted)]"><%= chain.length %> deep</span>
      </div>
      <%= render "shared/raid_timeline", chain: chain, current_name: deepest.name %>
    </div>
  <% end %>
</div>
