<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-[var(--text-bright)]">Tasks</h1>
    <span class="text-sm text-[var(--text-muted)]"><%= @task_count %> total</span>
  </div>

  <%= form_tag tasks_path, method: :get, class: "mb-4 flex items-center gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search tasks...", class: "flex-1 px-3 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] focus:outline-none" %>
    <button type="submit" class="px-4 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)]">
      Search
    </button>
  <% end %>

  <div id="task-list" class="space-y-2">
    <% @tasks.each do |task| %>
      <%= link_to task_path(task), class: "block bg-[var(--bg-surface)] border border-[var(--border)] p-4 hover:border-[var(--accent)] transition-colors" do %>
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-semibold text-[var(--text-bright)]"><%= task.full_name %></h3>
            <p class="text-sm text-[var(--text-muted)]">
              <%= task.given_by.titleize %> ·
              <% if task.kappa_required %>
                <span class="text-[var(--danger)]">Kappa Required</span>
              <% else %>
                No Kappa
              <% end %>
            </p>
          </div>
          <svg class="w-5 h-5 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
