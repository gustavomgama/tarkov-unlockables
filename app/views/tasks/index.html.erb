<% content_for :title, "Tasks" %>

<div class="space-y-4 sm:space-y-5">
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <h1 class="text-xl sm:text-2xl font-bold text-[var(--text-bright)]">Tasks</h1>
    <p class="font-data text-sm text-[var(--text-muted)]">
      <span class="text-[var(--text)]"><%= number_with_delimiter(@task_count) %></span> quests
    </p>
  </div>

  <%= form_tag tasks_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
    <% if params[:trader].present? %>
      <%= hidden_field_tag :trader, params[:trader] %>
    <% end %>
    <div class="relative flex-1 min-w-[10rem]">
      <%= text_field_tag :q, params[:q], type: "search", placeholder: "Search by quest name…", class: "input", "aria-label": "Search tasks" %>
    </div>
    <button type="submit" class="btn">Search</button>
    <% if params[:q].present? %>
      <%= link_to "Clear", tasks_path(trader: params[:trader]), class: "text-sm text-[var(--danger)] hover:underline px-2" %>
    <% end %>
  <% end %>

  <nav class="flex flex-wrap gap-1.5" aria-label="Filter by trader">
    <%= link_to "All traders", tasks_path(q: params[:q]),
          class: "chip chip--tap #{params[:trader].blank? ? 'chip--strong border-[var(--accent)] text-[var(--accent)]' : 'chip--link'}",
          "aria-current": (params[:trader].blank? ? "true" : nil) %>
    <% @traders.each do |trader| %>
      <% active = params[:trader] == trader %>
      <%= link_to tasks_path(q: params[:q], trader: trader),
            class: "chip chip--tap #{active ? 'chip--strong border-[var(--accent)] text-[var(--accent)]' : 'chip--link'}",
            "aria-current": (active ? "true" : nil) do %>
        <span class="trader-dot" style="background: var(--trader-<%= trader.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
        <%= trader.titleize %>
      <% end %>
    <% end %>
  </nav>

  <% if @tasks.none? %>
    <div class="panel">
      <div class="panel__body text-center py-10">
        <p class="text-sm text-[var(--text)]">No quests match this search.</p>
        <p class="mt-1 text-xs text-[var(--text-muted)]">Try a shorter name or clear the trader filter.</p>
        <%= link_to "Show all quests", tasks_path, class: "btn mt-4" %>
      </div>
    </div>
  <% else %>
    <div id="task-list" class="border border-[var(--border)]">
      <% @tasks.each do |task| %>
        <%= link_to task_path(task), class: "flex items-center gap-3 px-3 py-2.5 hover:bg-[var(--bg-elevated)] no-underline border-b border-[var(--border)] last:border-b-0" do %>
          <span class="trader-dot" style="background: var(--trader-<%= task.given_by.to_s.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
          <span class="min-w-0 flex-1">
            <h3 class="text-sm font-bold text-[var(--text-bright)] truncate"><%= task.full_name %></h3>
            <span class="block text-xs text-[var(--text-muted)]">
              <%= task.given_by.to_s.titleize %>
              <% if task.leads_tos_count.to_i.positive? %>
                · <span class="font-data"><%= task.leads_tos_count %></span> follow<%= "s" if task.leads_tos_count != 1 %>
              <% end %>
            </span>
          </span>
          <% if task.kappa_required %>
            <span class="chip" style="background: var(--danger); color: var(--text-bright)">Kappa</span>
          <% end %>
          <svg class="w-4 h-4 shrink-0 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
