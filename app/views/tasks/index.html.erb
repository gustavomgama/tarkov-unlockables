<% content_for :title, "Tasks" %>

<div class="space-y-4 sm:space-y-5">
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-[var(--text-bright)]">Tasks</h1>
      <p class="mt-1 text-sm text-[var(--text-muted)]">
        Every trader contract with its unlock path, requirements and rewards — press <kbd>/</kbd> to search.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <p class="font-data text-sm text-[var(--text-muted)]">
        <span class="text-[var(--text)]"><%= number_with_delimiter(@task_count) %></span> quests
      </p>
      <%= link_to "Task chains", chains_tasks_path, class: "chip chip--link" %>
    </div>
  </div>

  <%# Filter state carried through every chip and the search form, so
      narrowing by one facet never drops another. %>
  <% filters = { trader: params[:trader].presence, map: params[:map].presence,
                 kappa: params[:kappa].presence } %>

  <%= form_tag tasks_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
    <% filters.each do |key, value| %>
      <%= hidden_field_tag key, value if value.present? %>
    <% end %>
    <div class="relative flex-1 min-w-[10rem]"
         data-controller="search"
         data-search-url-value="<%= search_tasks_path %>"
         data-action="keydown->search#keydown">
      <%= text_field_tag :q, params[:q], type: "search", placeholder: "Search by quest name…",
            class: "input", "aria-label": "Search tasks",
            autocomplete: "off",
            "aria-controls": "search-results",
            data: { search_target: "input", action: "input->search#query" } %>

      <div
        id="search-results"
        class="hidden absolute left-0 right-0 top-full z-50 mt-1 max-h-96 overflow-y-auto bg-[var(--bg-surface)] border border-[var(--border)]"
        data-search-target="results"
        role="status"
        aria-live="polite"
        aria-label="Search results"
      ></div>
    </div>
    <button type="submit" class="btn">Search</button>
    <% if params[:q].present? %>
      <%= link_to "Clear", tasks_path(filters), class: "text-sm text-[var(--danger)] hover:underline px-2" %>
    <% end %>
  <% end %>

  <nav class="flex flex-wrap gap-1.5" aria-label="Filter by trader">
    <%= link_to "All traders", tasks_path(filters.except(:trader)),
          class: "chip chip--tap #{params[:trader].blank? && params[:kappa].blank? ? 'chip--strong border-[var(--accent)] text-[var(--accent)]' : 'chip--link'}",
          "aria-current": (params[:trader].blank? ? "true" : nil) %>
    <%= link_to tasks_path(params[:kappa].present? ? filters.except(:kappa) : filters.merge(kappa: 1)),
          class: "chip chip--tap #{params[:kappa].present? ? 'chip--strong border-[var(--danger)] text-[var(--danger)]' : 'chip--link'}",
          "aria-current": (params[:kappa].present? ? "true" : nil) do %>
      Kappa only <span class="font-data text-[var(--text-muted)]"><%= @kappa_count %></span>
    <% end %>
    <% @traders.each do |trader| %>
      <% active = params[:trader] == trader %>
      <%= link_to tasks_path(filters.merge(trader: trader)),
            class: "chip chip--tap #{active ? 'chip--strong border-[var(--accent)] text-[var(--accent)]' : 'chip--link'}",
            "aria-current": (active ? "true" : nil) do %>
        <span class="trader-dot" style="background: var(--trader-<%= trader.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
        <%= trader.titleize %>
      <% end %>
    <% end %>
  </nav>

  <% if @maps.any? %>
    <nav class="flex flex-wrap gap-1.5" aria-label="Filter by map">
      <% @maps.each do |map| %>
        <% active = params[:map] == map %>
        <%= link_to tasks_path(active ? filters.except(:map) : filters.merge(map: map)),
              class: "chip chip--tap #{active ? 'chip--strong border-[var(--accent)] text-[var(--accent)]' : 'chip--link'}",
              "aria-current": (active ? "true" : nil) do %>
          <%= map %>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <% if @tasks.none? %>
    <div class="panel">
      <div class="panel__body text-center py-10">
        <p class="text-sm text-[var(--text)]">No quests match this search.</p>
        <p class="mt-1 text-xs text-[var(--text-muted)]">Try a shorter name, or clear the filters.</p>
        <%= link_to "Show all quests", tasks_path, class: "btn mt-4" %>
      </div>
    </div>
  <% else %>
    <div id="task-list" class="border border-[var(--border)]">
      <% @tasks.each do |task| %>
        <%= link_to task_path(task), class: "task-row" do %>
          <span class="trader-dot" style="background: var(--trader-<%= task.given_by.to_s.parameterize %>, var(--text-muted));" aria-hidden="true"></span>
          <span class="min-w-0 flex-1">
            <h2 class="text-sm font-bold text-[var(--text-bright)] truncate"><%= task.full_name %></h2>
            <span class="block text-xs text-[var(--text-muted)]">
              <%= task.given_by.to_s.titleize %>
              <% if task.map_name.present? %>
                · <%= task.map_name %>
              <% end %>
              <% if task.leads_tos_count.to_i.positive? %>
                · <span class="font-data"><%= task.leads_tos_count %></span> follow<%= "s" if task.leads_tos_count != 1 %>
              <% end %>
            </span>
          </span>
          <% if task.kappa_required %>
            <span class="chip" style="background: var(--danger); color: var(--text-bright)">Kappa</span>
          <% end %>
          <% if task.lightkeeper_required %>
            <span class="chip" style="background: var(--trader-lightkeeper); color: var(--text-bright)">Lightkeeper</span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# 468 rows: after reading to the bottom, getting back to the filters
        should not be a long fling. %>
    <div class="mt-3 flex justify-end">
      <%= link_to "↑ Back to top", "#main", class: "text-xs text-[var(--text-muted)] hover:text-[var(--accent)]" %>
    </div>
  <% end %>
</div>
