<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} // TARKOV DB" : "Tarkov Unlock Navigator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Escape from Tarkov item, task and trader unlock reference." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans min-h-screen">
    <div data-controller="theme">
      <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-6">
              <%= link_to "Tarkov DB", root_path, class: "text-xl font-bold tracking-tight" %>
              <nav class="hidden md:flex gap-4">
                <%= link_to "Items", items_path, class: "text-sm font-medium hover:text-blue-600 dark:hover:text-blue-400" %>
                <%= link_to "Tasks", tasks_path, class: "text-sm font-medium hover:text-blue-600 dark:hover:text-blue-400" %>
              </nav>
            </div>
            <div class="flex items-center gap-4">
              <button
                type="button"
                data-action="theme#toggle"
                class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                aria-label="Toggle theme"
              >
                <svg data-theme-target="sun" class="hidden dark:block w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <svg data-theme-target="moon" class="block dark:hidden w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </header>

      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%= yield %>
      </main>

      <footer class="border-t border-gray-200 dark:border-gray-800 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <div class="text-sm text-gray-500 dark:text-gray-400">
            data:
            <%= link_to "tarkov.dev", "https://tarkov.dev", class: "hover:text-blue-600 dark:hover:text-blue-400", target: "_blank", rel: "noopener" %> ·
            <%= link_to "Escape from Tarkov Wiki", "https://escapefromtarkov.fandom.com", class: "hover:text-blue-600 dark:hover:text-blue-400", target: "_blank", rel: "noopener" %> ·
            <%= link_to "tarkov-market.com", "https://tarkov-market.com", class: "hover:text-blue-600 dark:hover:text-blue-400", target: "_blank", rel: "noopener" %>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
