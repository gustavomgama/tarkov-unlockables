<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} // TARKOV DB" : "Tarkov Unlock Navigator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Escape from Tarkov item, task and trader unlock reference." %>">
    <meta name="theme-color" content="#06080a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "tailwind" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://tarkov.dev" crossorigin>
    <link rel="preload" href="https://tarkov.dev/fonts/bender.woff2" as="font" type="font/woff2" crossorigin="">
    <link rel="preload" href="https://tarkov.dev/fonts/bender-bold.woff2" as="font" type="font/woff2" crossorigin="">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <style>
      @font-face {
        font-family: 'bender';
        font-display: block;
        font-style: normal;
        font-weight: 400;
        src: local('Bender Regular'), url('https://tarkov.dev/fonts/bender.woff2') format('woff2');
      }
      @font-face {
        font-family: 'bender';
        font-display: swap;
        font-style: normal;
        font-weight: 700;
        src: local('Bender Bold'), url('https://tarkov.dev/fonts/bender-bold.woff2') format('woff2');
      }

      @layer base {
        :root {
          --bg-dark: #06080a;
          --bg-panel: #0d1117;
          --bg-surface: #12161c;
          --bg-elevated: #1a1f26;
          --text: #e8e4d8;
          --text-bright: #f6f1e7;
          --text-muted: #9a9488;
          --accent: #c9a84c;
          --accent-hover: #dcc06a;
          --border: #262b33;
          --border-strong: #363d47;
          --success: #6a9a4a;
          --danger: #b8433a;

          /* Lethality ramp: one colour language shared by armor class and
             penetration, so a number's meaning reads without the threshold
             table. Class 1 (light) → class 6 (heavy). */
          --ac1: #5b6b7a;
          --ac2: #4f7a6a;
          --ac3: #7c8a44;
          --ac4: #a8903f;
          --ac5: #b5703a;
          --ac6: #b0463a;

          --badge-task: #7a6b8a;
          --badge-barter: #5a8a8a;
          --badge-craft: #6a8a6a;
          --badge-hideout: #5a7a5a;
          --badge-currency: #5a7a8a;
          --badge-offer: #8a8a5a;
          --trader-prapor: #8a5a3c;
          --trader-therapist: #7a8a5a;
          --trader-fence: #9a7a4a;
          --trader-skier: #5a6a8a;
          --trader-ragman: #8a6a8a;
          --trader-mechanic: #5a8a7a;
          --trader-jaeger: #6a7a4a;
          --trader-lightkeeper: #4a7a8a;
          --trader-peacekeeper: #4a6a8a;
          --trader-ref: #7a7a7a;
          --trader-btr-driver: #6a6a5a;
          --font-data: 'bender', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        html {
          background-color: var(--bg-dark);
          overflow-x: clip;
        }
        body {
          background-color: var(--bg-dark);
          color: var(--text);
          font-family: 'bender', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
          font-weight: 400;
          word-spacing: 1px;
          -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.01em; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { color: var(--accent-hover); text-decoration: underline; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        .font-data { font-family: var(--font-data); font-variant-numeric: tabular-nums; }
      }

      @layer components {
        /* Skip link: keyboard users land here first. */
        .skip-link {
          position: absolute;
          left: -9999px;
          top: 0;
        }
        .skip-link:focus {
          left: 0.75rem;
          top: 0.75rem;
          z-index: 100;
          padding: 0.5rem 0.75rem;
          background: var(--accent);
          color: var(--bg-dark);
          font-size: 0.8125rem;
          font-weight: 700;
          text-decoration: none;
        }

        /* Masthead */
        .nav-link {
          display: inline-flex;
          align-items: center;
          min-height: 2.75rem;
          padding: 0 0.125rem;
          font-size: 0.875rem;
          font-weight: 400;
          color: var(--text-muted);
          border-bottom: 2px solid transparent;
          text-decoration: none;
        }
        .nav-link:hover { color: var(--text); text-decoration: none; }
        .nav-link[aria-current="page"] {
          color: var(--accent);
          font-weight: 700;
          border-bottom-color: var(--accent);
        }

        /* Panels: the only container shape on the site. */
        .panel {
          background: var(--bg-surface);
          border: 1px solid var(--border);
        }
        .panel__head {
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          gap: 0.75rem;
          padding: 0.75rem 1rem;
          border-bottom: 1px solid var(--border);
        }
        .panel__title {
          font-size: 0.9375rem;
          font-weight: 700;
          color: var(--text-bright);
        }
        .panel__note { font-size: 0.75rem; color: var(--text-muted); }
        .panel__body { padding: 1rem; }
        .panel__body--flush { padding: 0; }

        /* Stat readout: one framed block. The primary row is a grid of the
           numbers that decide the item; everything else is a spec list, so a
           leftover cell can never leave a hole in the grid. */
        .readout {
          background: var(--bg-surface);
          border: 1px solid var(--border);
        }
        .readout > * + * { border-top: 1px solid var(--border); }
        .readout .stats { border: 0; }
        .stats {
          display: flex;
          flex-wrap: wrap;
          gap: 1px;
          margin: 0;
          background: var(--border);
          border: 1px solid var(--border);
        }
        .stat {
          flex: 1 1 calc(50% - 2px);
          min-width: 0;
          padding: 0.75rem 0.875rem;
          background: var(--bg-surface);
        }
        @media (min-width: 640px) {
          .stat { flex-basis: 7rem; }
        }
        .stat--wide { flex: 1 1 100%; }
        .stat__key {
          display: block;
          margin: 0 0 0.25rem;
          font-size: 0.625rem;
          font-weight: 400;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: var(--text-muted);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .stat__val {
          display: block;
          margin: 0;
          font-weight: 700;
          font-size: 1.0625rem;
          line-height: 1.2;
          color: var(--text-bright);
          font-variant-numeric: tabular-nums;
          overflow-wrap: anywhere;
        }
        .stat__val a { color: inherit; }
        .stat__note {
          display: block;
          margin: 0;
          font-size: 0.6875rem;
          color: var(--text-muted);
        }
        .stat--xl .stat__val {
          font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem);
          letter-spacing: -0.02em;
          line-height: 1;
        }
        .stat--tone .stat__val { color: var(--tone); }

        /* Secondary specs: label left, value right, one fact per row. */
        .specs { margin: 0; }
        .spec {
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          gap: 1rem;
          padding: 0.4375rem 1rem;
          font-size: 0.8125rem;
        }
        .spec + .spec { border-top: 1px solid var(--border); }
        .spec__key { flex-shrink: 0; color: var(--text-muted); }
        .spec__val {
          margin: 0;
          min-width: 0;
          text-align: right;
          color: var(--text-bright);
          font-weight: 700;
          font-variant-numeric: tabular-nums;
          overflow-wrap: anywhere;
        }


        /* Armor-class / penetration ladder: six blocks, lit up to the rating. */
        .ac-grid {
          display: grid;
          grid-template-columns: repeat(6, 1fr);
          gap: 0.25rem;
          max-width: 34rem;
        }
        .ac-cell {
          display: flex;
          align-items: center;
          justify-content: center;
          height: 1.75rem;
          background: var(--bg-elevated);
          border: 1px solid var(--border);
          font-size: 0.75rem;
          font-variant-numeric: tabular-nums;
          color: var(--text-muted);
        }
        .ac-cell--on {
          background: var(--tone);
          border-color: var(--tone);
          color: #0a0c0e;
          font-weight: 700;
        }

        /* Horizontal meter for ergonomics / recoil style values. */
        .meter {
          height: 0.25rem;
          background: var(--bg-elevated);
          overflow: hidden;
        }
        .meter__fill { height: 100%; background: var(--tone, var(--accent)); }

        /* Chips */
        .chip {
          display: inline-flex;
          align-items: center;
          gap: 0.3rem;
          padding: 0.1875rem 0.4375rem;
          font-size: 0.6875rem;
          line-height: 1.4;
          background: var(--bg-elevated);
          color: var(--text-muted);
          border: 1px solid var(--border);
        }
        .chip--strong { color: var(--text); }
        .chip--link { color: var(--text); }
        /* Interactive chips are thumb targets, not labels. */
        .chip--tap { align-items: center; min-height: 2.5rem; padding: 0.4375rem 0.6875rem; }
        .chip--link:hover {
          border-color: var(--accent);
          color: var(--accent);
          text-decoration: none;
        }

        /* Form fields */
        .input {
          width: 100%;
          min-height: 2.75rem;
          padding: 0.5rem 0.75rem;
          font-family: inherit;
          font-size: 0.875rem;
          color: var(--text);
          background: var(--bg-surface);
          border: 1px solid var(--border);
          border-radius: 0;
        }
        .input::placeholder { color: var(--text-muted); }
        .input:focus { border-color: var(--accent); outline: none; }
        .input[type="search"]::-webkit-search-cancel-button { filter: invert(0.7); }

        /* Buttons: square corners, no glow. */
        .btn {          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.375rem;
          min-height: 2.75rem;
          padding: 0.5rem 0.875rem;
          font-size: 0.8125rem;
          font-weight: 700;
          border: 1px solid var(--border);
          background: var(--bg-surface);
          color: var(--text);
          transition: border-color 120ms ease, color 120ms ease, background-color 120ms ease;
        }
        .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
        .btn--accent { background: var(--accent); border-color: var(--accent); color: #0a0c0e; }
        .btn--accent:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: #0a0c0e; }
        .btn--danger { border-color: var(--danger); color: var(--danger); }
        .btn--danger:hover { background: var(--danger); border-color: var(--danger); color: var(--text-bright); }

        /* Item card */
        .card {
          display: block;
          background: var(--bg-surface);
          border: 1px solid var(--border);
          transition: border-color 120ms ease, transform 120ms ease;
        }
        .card:hover { border-color: var(--accent); transform: translateY(-1px); text-decoration: none; }
        .card__media {
          position: relative;
          aspect-ratio: 4 / 3;
          background: var(--bg-panel);
          overflow: hidden;
        }
        .card__img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          transition: transform 160ms ease-out;
        }
        .card:hover .card__img { transform: scale(1.04); }
        .card__body { padding: 0.625rem 0.6875rem 0.6875rem; }
        .card__name {
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
          font-size: 0.8125rem;
          font-weight: 700;
          line-height: 1.3;
          color: var(--text-bright);
          margin-bottom: 0.375rem;
          overflow-wrap: anywhere;
        }

        /* Trader dot shared by lists and timelines. */
        .trader-dot {
          width: 0.5rem;
          height: 0.5rem;
          border-radius: 9999px;
          flex-shrink: 0;
          background: var(--trader-unknown, var(--text-muted));
        }

        /* Timeline */
        .timeline-node { position: relative; padding-left: 1.5rem; padding-bottom: 0.875rem; }
        .timeline-node:last-child { padding-bottom: 0; }

        /* Disclosure: collapsed by default so long reference pages end at the
           data. Marker is drawn by CSS in both engines. */
        .disclosure > summary {
          cursor: pointer;
          list-style: none;
        }
        .disclosure > summary::-webkit-details-marker { display: none; }
        .disclosure > summary::after {
          content: "+";
          font-weight: 700;
          color: var(--text-muted);
        }
        .disclosure[open] > summary::after { content: "−"; }

        /* Breadcrumbs */
        .crumbs {
          display: flex;
          align-items: center;
          flex-wrap: wrap;
          gap: 0.375rem;
          font-size: 0.75rem;
          color: var(--text-muted);
        }
        .crumbs a { color: var(--text-muted); }
        .crumbs a:hover { color: var(--accent); }

        /* Source badge: what kind of acquisition a row describes. */
        .srcbadge {
          display: inline-flex;
          align-items: center;
          flex-shrink: 0;
          padding: 0.1875rem 0.4375rem;
          font-size: 0.625rem;
          font-weight: 700;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: var(--text-bright);
          background: var(--tone, var(--bg-elevated));
        }

        /* Acquisition rows: badge on the left, detail lines on the right. */
        .srcrow {
          display: flex;
          align-items: flex-start;
          gap: 0.625rem;
          padding: 0.6875rem 1rem;
        }
        .srcrow + .srcrow { border-top: 1px solid var(--border); }
        .srcrow__body { min-width: 0; flex: 1; }
        .srcrow__title {
          font-size: 0.8125rem;
          color: var(--text-bright);
          overflow-wrap: anywhere;
        }
        .srcrow__meta {
          margin-top: 0.125rem;
          font-size: 0.75rem;
          color: var(--text-muted);
        }

        /* Comparison table: one row per round, aligned numbers. */
        .ammo-table { background: var(--bg-surface); }
        .ammo-table__head,
        .ammo-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 2.75rem 2.75rem 2.75rem;
          align-items: center;
          gap: 0.5rem;
          padding: 0.5rem 1rem;
        }
        .ammo-table__head {
          border-bottom: 1px solid var(--border);
          font-size: 0.625rem;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: var(--text-muted);
        }
        .ammo-table__head span:not(:first-child) { text-align: right; }
        .ammo-row + .ammo-row { border-top: 1px solid var(--border); }
        .ammo-row:hover { background: var(--bg-elevated); text-decoration: none; }
        .ammo-row--current {
          background: var(--bg-elevated);
          box-shadow: inset 2px 0 0 var(--accent);
        }
        .ammo-row__name {
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          font-size: 0.8125rem;
          color: var(--text);
        }
        .ammo-row--current .ammo-row__name { color: var(--accent); font-weight: 700; }
        .ammo-row__num {
          text-align: right;
          font-size: 0.8125rem;
          font-variant-numeric: tabular-nums;
          color: var(--text-bright);
        }
        .ammo-row__num--muted { color: var(--text-muted); }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="border-b border-[var(--border)] bg-[var(--bg-panel)] sticky top-0 z-50" data-controller="mobile-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14 sm:h-16">
          <div class="flex items-center gap-5 sm:gap-7">
            <%= link_to root_path, class: "flex items-baseline gap-1.5 text-[var(--accent)] hover:text-[var(--accent-hover)] no-underline" do %>
              <span class="text-base sm:text-lg font-bold tracking-tight">TARKOV</span>
              <span class="text-base sm:text-lg font-normal text-[var(--text-muted)]">DB</span>
            <% end %>
            <nav class="hidden md:flex gap-5" aria-label="Primary">
              <%= link_to "Items", items_path, class: "nav-link", "aria-current": ("page" if controller_name == "items") %>
              <%= link_to "Tasks", tasks_path, class: "nav-link", "aria-current": ("page" if controller_name == "tasks") %>
              <%= link_to "Favorites", favorites_path, class: "nav-link", "aria-current": ("page" if controller_name == "favorites") %>
            </nav>
          </div>
          <button
            type="button"
            class="md:hidden p-2 -mr-2 text-[var(--text)] w-11 h-11 flex items-center justify-center"
            data-action="mobile-nav#toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Menu"
          >
            <svg data-mobile-nav-target="icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" data-mobile-nav-target="menu" class="hidden md:hidden border-t border-[var(--border)]" aria-label="Primary">
        <div class="px-4 py-2 space-y-0.5">
          <%= link_to "Items", items_path, class: "block px-3 py-2 text-sm text-[var(--text)] hover:text-[var(--accent)] hover:bg-[var(--bg-elevated)] min-h-[44px] flex items-center #{controller_name == 'items' ? 'text-[var(--accent)] font-bold' : ''}" %>
          <%= link_to "Tasks", tasks_path, class: "block px-3 py-2 text-sm text-[var(--text)] hover:text-[var(--accent)] hover:bg-[var(--bg-elevated)] min-h-[44px] flex items-center #{controller_name == 'tasks' ? 'text-[var(--accent)] font-bold' : ''}" %>
          <%= link_to "Favorites", favorites_path, class: "block px-3 py-2 text-sm text-[var(--text)] hover:text-[var(--accent)] hover:bg-[var(--bg-elevated)] min-h-[44px] flex items-center #{controller_name == 'favorites' ? 'text-[var(--accent)] font-bold' : ''}" %>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-[var(--border)] mt-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <%= render "shared/feedback" %>

        <div class="text-xs text-[var(--text-muted)] mt-3">
          data:
          <%= link_to "tarkov.dev", "https://tarkov.dev", target: "_blank", rel: "noopener" %> ·
          <%= link_to "Escape from Tarkov Wiki", "https://escapefromtarkov.fandom.com", target: "_blank", rel: "noopener" %> ·
          <%= link_to "tarkov-market.com", "https://tarkov-market.com", target: "_blank", rel: "noopener" %>
        </div>
      </div>
    </footer>
  </body>
</html>
