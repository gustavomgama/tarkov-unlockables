<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} // TARKOV DB" : "Tarkov Unlock Navigator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Escape from Tarkov item, task and trader unlock reference." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "tailwind" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://tarkov.dev" crossorigin>
    <link rel="preload" href="https://tarkov.dev/fonts/bender.woff2" as="font" type="font/woff2" crossorigin="">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <style>
      @font-face {
        font-family: 'bender';
        font-display: block;
        font-style: normal;
        font-weight: 400;
        src: local('Bender Regular'), url('https://tarkov.dev/fonts/bender.woff2') format('woff2');
      }
      @font-face {
        font-family: 'bender';
        font-display: swap;
        font-style: normal;
        font-weight: 700;
        src: local('Bender Bold'), url('https://tarkov.dev/fonts/bender-bold.woff2') format('woff2');
      }
      @layer base {
        :root {
          --bg-dark: #0a0a0a;
          --bg-panel: #12161c;
          --bg-surface: #1a1a1a;
          --bg-elevated: #22252a;
          --text: #e0e0e0;
          --text-bright: #ffffff;
          --text-muted: #9a9a9a;
          --accent: #d2af78;
          --accent-hover: #e6c58c;
          --border: #333333;
          --border-faint: rgba(255,255,255,0.08);
          --success: #00a700;
          --danger: #cd1e2f;
          --badge-task: #7a6b8a;
          --badge-barter: #5a8a8a;
          --badge-craft: #6a8a6a;
          --badge-hideout: #5a7a5a;
          --badge-currency: #5a7a8a;
          --badge-offer: #8a8a5a;
          --trader-prapor: #8a5a3c;
          --trader-therapist: #7a8a5a;
          --trader-fence: #9a7a4a;
          --trader-skier: #5a6a8a;
          --trader-ragman: #8a6a8a;
          --trader-mechanic: #5a8a7a;
          --trader-jaeger: #6a7a4a;
          --trader-lightkeeper: #4a7a8a;
          --trader-peacekeeper: #4a6a8a;
          --trader-ref: #7a7a7a;
          --trader-btr-driver: #6a6a5a;
          --font-data: 'bender', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        html { background-color: var(--bg-dark); }
        body {
          background-color: var(--bg-dark);
          color: var(--text);
          font-family: 'bender', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
          font-weight: 400;
          word-spacing: 1px;
          -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, .font-bold, .font-semibold { font-weight: 700; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { color: var(--accent-hover); text-decoration: underline; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        .font-data {
          font-family: var(--font-data);
          font-variant-numeric: tabular-nums;
        }
        .trader-dot {
          width: 0.5rem; height: 0.5rem; border-radius: 9999px; flex-shrink: 0;
          background: var(--trader-unknown, var(--text-muted));
        }
        @media (prefers-reduced-motion: no-preference) {
          .timeline-node { animation: node-in 200ms ease-out backwards; }
          .timeline-node:nth-child(2) { animation-delay: 60ms; }
          .timeline-node:nth-child(3) { animation-delay: 120ms; }
          .timeline-node:nth-child(4) { animation-delay: 180ms; }
          .timeline-node:nth-child(5) { animation-delay: 240ms; }
          .timeline-node:nth-child(n+6) { animation-delay: 300ms; }
        }
        @keyframes node-in {
          from { opacity: 0; transform: translateY(4px); }
          to { opacity: 1; transform: translateY(0); }
        }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-[var(--border)] bg-[var(--bg-panel)] sticky top-0 z-50" data-controller="mobile-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-6">
            <%= link_to "Tarkov DB", root_path, class: "text-xl font-bold tracking-tight text-[var(--accent)]" %>
            <nav class="hidden md:flex gap-4">
              <%= link_to "Items", items_path, class: "text-sm font-medium text-[var(--text)] hover:text-[var(--accent)]" %>
              <%= link_to "Tasks", tasks_path, class: "text-sm font-medium text-[var(--text)] hover:text-[var(--accent)]" %>
              <%= link_to "Favorites", favorites_path, class: "text-sm font-medium text-[var(--text)] hover:text-[var(--accent)]" %>
            </nav>
          </div>
          <button
            type="button"
            class="md:hidden p-2 -mr-2 text-[var(--text)] min-w-[44px] min-h-[44px] flex items-center justify-center"
            data-action="mobile-nav#toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Menu"
          >
            <svg data-mobile-nav-target="icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" data-mobile-nav-target="menu" class="hidden md:hidden border-t border-[var(--border)]">
        <div class="px-4 py-3 space-y-1">
          <%= link_to "Items", items_path, class: "block px-3 py-2 text-sm font-medium text-[var(--text)] hover:text-[var(--accent)] hover:bg-[var(--bg-elevated)] min-h-[44px] flex items-center" %>
          <%= link_to "Tasks", tasks_path, class: "block px-3 py-2 text-sm font-medium text-[var(--text)] hover:text-[var(--accent)] hover:bg-[var(--bg-elevated)] min-h-[44px] flex items-center" %>
          <%= link_to "Favorites", favorites_path, class: "block px-3 py-2 text-sm font-medium text-[var(--text)] hover:text-[var(--accent)] hover:bg-[var(--bg-elevated)] min-h-[44px] flex items-center" %>
        </div>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-[var(--border)] mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="text-sm text-[var(--text-muted)]">
          data:
          <%= link_to "tarkov.dev", "https://tarkov.dev", class: "hover:text-[var(--accent)]", target: "_blank", rel: "noopener" %> ·
          <%= link_to "Escape from Tarkov Wiki", "https://escapefromtarkov.fandom.com", class: "hover:text-[var(--accent)]", target: "_blank", rel: "noopener" %> ·
          <%= link_to "tarkov-market.com", "https://tarkov-market.com", class: "hover:text-[var(--accent)]", target: "_blank", rel: "noopener" %>
        </div>
      </div>
    </footer>
  </body>
</html>
