<% content_for :title, "Favorites" %>

<div class="space-y-4 sm:space-y-5">
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <h1 class="text-xl sm:text-2xl font-bold text-[var(--text-bright)]">Favorites</h1>
    <p class="font-data text-sm text-[var(--text-muted)]">
      <% if @favorite_items.any? %>
        <span class="text-[var(--text)]"><%= @favorite_items.size %></span> saved
      <% end %>
    </p>
  </div>

  <% if @favorite_items.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-2.5 sm:gap-3">
      <% task_gated_item_ids(@favorite_items) %>
      <%= render partial: "favorites/card", collection: @favorite_items, as: :card %>
    </div>
  <% else %>
    <div class="panel">
      <div class="panel__body text-center py-10">
        <p class="text-sm text-[var(--text)]">Nothing saved yet.</p>
        <p class="mt-1 text-xs text-[var(--text-muted)]">
          Open any item and press Add favorite to keep it here. There are no
          accounts on this site yet.
        </p>
        <%= link_to "Browse items", items_path, class: "btn mt-4" %>
      </div>
    </div>
  <% end %>
</div>
