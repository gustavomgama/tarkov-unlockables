<%= link_to item_path(card), class: "group block bg-[var(--bg-surface)] border border-[var(--border)] overflow-hidden hover:border-[var(--accent)] transition-colors" do %>
  <div class="aspect-square bg-[var(--bg-panel)] overflow-hidden">
    <img
      src="<%= image_url %>"
      alt="<%= card.full_name %>"
      class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    >
  </div>
  <div class="p-4">
    <h3 class="font-semibold text-sm line-clamp-2 mb-2 text-[var(--text-bright)]"><%= card.full_name %></h3>
    <div class="flex flex-wrap gap-1">
      <% category_badges.each do |cat| %>
        <span class="inline-block px-2 py-0.5 text-xs bg-[var(--bg-elevated)] text-[var(--text-muted)] border border-[var(--border)]">
          <%= cat.humanize %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
