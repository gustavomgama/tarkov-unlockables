<%# A native <details> disclosure: the filter still opens and applies with
    JavaScript disabled. The controller only adds Escape / click-outside. %>
<details
  class="filter-group"
  data-controller="disclosure"
  data-action="keydown.esc->disclosure#closeOnEscape click@document->disclosure#closeOnOutsideClick"
>
  <summary>
    <span><%= @title %></span>
    <% if @selected.any? %>
      <span class="filter-group__count"><%= @selected.count %></span>
    <% end %>
    <svg class="filter-group__chevron w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>

  <div class="filter-group__menu">
    <% @options.each do |option| %>
      <label class="filter-group__option">
        <input
          type="checkbox"
          name="filters[<%= @name %>][]"
          value="<%= option[:value] %>"
          <%= "checked" if checked?(option[:value]) %>
          data-action="change->filter-form#submit"
          class="border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)]"
        >
        <span class="filter-group__label"><%= option[:label] %></span>
        <% if option[:count] %>
          <span class="filter-group__hint"><%= option[:count] %></span>
        <% end %>
      </label>
    <% end %>
  </div>
</details>
