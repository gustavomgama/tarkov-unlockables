<div class="relative" data-controller="filter-group">
  <button
    type="button"
    data-action="filter-group#toggle"
    class="flex items-center gap-2 px-3 py-2 text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text)] hover:border-[var(--accent)]"
  >
    <span><%= @title %></span>
    <% if @selected.any? %>
      <span class="px-1.5 py-0.5 text-xs bg-[var(--accent)] text-[var(--bg-dark)]">
        <%= @selected.count %>
      </span>
    <% end %>
    <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    data-filter-group-target="dropdown"
    class="hidden absolute z-10 top-full left-0 mt-1 w-56 bg-[var(--bg-surface)] border border-[var(--border)] p-3"
  >
    <div class="space-y-1">
      <% @options.each do |option| %>
        <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-[var(--bg-elevated)] cursor-pointer">
          <input
            type="checkbox"
            name="filters[<%= @name %>][]"
            value="<%= option[:value] %>"
            <%= 'checked' if checked?(option[:value]) %>
            class="filter-checkbox border-[var(--border)] text-[var(--accent)] focus:ring-[var(--accent)]"
          >
          <span class="flex-1 text-sm text-[var(--text)]"><%= option[:label] %></span>
          <% if option[:count] %>
            <span class="text-xs text-[var(--text-muted)]">(<%= option[:count] %>)</span>
          <% end %>
        </label>
      <% end %>
    </div>
  </div>
</div>
